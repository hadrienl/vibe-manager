<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  CloudKit in the container of the application and of the Mac's companion agent (#368): the
  extension fetches the request a push is about. No push entitlement: the application receives
  them, and iOS hands their content to the extension.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.eu.hadrien.VibeManager</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>$(VIBE_CLOUDKIT_ENVIRONMENT)</string>
</dict>
</plist>
