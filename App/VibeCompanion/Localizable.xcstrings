    "The agent stops. The session keeps its conversation and can be restarted." : {
      "comment" : "Confirmation message for closing a session.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’agent s’arrête. La session garde sa conversation et peut être relancée."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتوقف الوكيل. تحتفظ الجلسة بمحادثتها ويمكن إعادة تشغيلها."
