    "Seen %@. Open Vibe Manager on the Mac, with Settings › iPhone Companion turned on." : {
      "comment" : "The banner of a Mac offline; %@ is when it was last seen.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vu %@. Ouvrez Vibe Manager sur le Mac, avec Réglages › Compagnon iPhone activé."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuletzt gesehen %@. Öffne Vibe Manager auf dem Mac, mit aktiviertem Einstellungen › iPhone-Begleiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visto %@. Abre Vibe Manager en el Mac, con Ajustes › Compañero para iPhone activado."
