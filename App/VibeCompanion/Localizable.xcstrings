    "Its agent no longer runs. Restart it to write to it." : {
      "comment" : "Detail of the closed-session bar.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’agent ne tourne plus. Relancez-le pour lui écrire."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد وكيلها يعمل. أعد تشغيله لتكتب إليها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Agent läuft nicht mehr. Starte ihn neu, um zu schreiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su agente ya no se está ejecutando. Reinícialo para escribirle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसका एजेंट अब नहीं चल रहा। इसे लिखने के लिए एजेंट को फिर से शुरू करो।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suo agente non è più in esecuzione. Riavvialo per scrivergli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントはもう動いていません。書き込むには再起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 더 이상 실행되지 않아요. 메시지를 보내려면 다시 시작하세요."
          }
        },
