    "The Mac can’t resume this conversation and asks what to do. Answer on the Mac." : {
      "comment" : "Failure when restarting a session.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Mac ne peut pas reprendre cette conversation et demande quoi faire : réponds sur le Mac."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع Mac استئناف هذه المحادثة ويسأل عما يجب فعله. أجب على Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mac kann diese Unterhaltung nicht fortsetzen und fragt, was zu tun ist. Antworte auf dem Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Mac no puede reanudar esta conversación y pregunta qué hacer. Responde en el Mac."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac इस बातचीत को फिर से शुरू नहीं कर सकता और पूछ रहा है कि क्या करना है। Mac पर जवाब दो।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Mac non può riprendere questa conversazione e chiede cosa fare. Rispondi sul Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macはこの会話を再開できず、どうするか尋ねています。Macで回答してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac에서 이 대화를 이어갈 수 없어서 어떻게 할지 묻고 있어요. Mac에서 답변해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Mac kan dit gesprek niet hervatten en vraagt wat te doen. Antwoord op de Mac."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac nie może wznowić tej rozmowy i pyta, co zrobić. Odpowiedz na Macu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mac não consegue retomar esta conversa e pergunta o que fazer. Responda no Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac не может возобновить эту беседу и спрашивает, что делать. Ответь на Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac bu konuşmayı sürdüremiyor ve ne yapılacağını soruyor. Mac’ten cevapla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac не може відновити цю розмову й питає, що робити. Відповідай на Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 无法继续这段对话，正在询问该怎么办。请在 Mac 上回答。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 無法繼續這段對話，並詢問該怎麼做。請在 Mac 上回答。"
          }
        }
      }
    },
