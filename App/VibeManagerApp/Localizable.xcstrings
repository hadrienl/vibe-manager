    "Go back to it to finish them, or quit without them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عُد إليه لإكمالها، أو قم بالإنهاء من دونها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehre dorthin zurück, um sie abzuschließen, oder beende ohne sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a ella para terminarlas o sal sin ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revenez-y pour les terminer, ou quittez sans elles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उन्हें पूरा करने के लिए वहाँ वापस जाएँ, या उनके बिना बाहर निकलें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna indietro per completarle o esci senza di esse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "戻って完了させるか、それらを破棄して終了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "돌아가서 마무리하거나, 저장하지 않고 종료하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga ernaar terug om ze af te maken, of stop zonder ze."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wróć do niego, aby je dokończyć, lub zakończ bez nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volte a ela para concluí-las, ou encerre sem elas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вернитесь к нему, чтобы их завершить, или выйдите без них."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onları bitirmek için geri dönün ya da onlar olmadan çıkın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поверніться до нього, щоб завершити їх, або вийдіть без них."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返回以完成它们，或不带它们直接退出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請回到該處完成它們，或直接結束而不保留。"
          }
        }
      }
    },
