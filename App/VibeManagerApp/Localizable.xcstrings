    "Copy them before quitting, or what was typed since the last save is lost." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انسخها قبل الإنهاء، وإلا فستفقد ما كُتب منذ آخر حفظ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiere sie vor dem Beenden, sonst geht alles verloren, was seit dem letzten Sichern eingegeben wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cópialas antes de salir; de lo contrario, se perderá lo escrito desde la última vez que se guardó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiez-les avant de quitter, sinon ce qui a été saisi depuis le dernier enregistrement sera perdu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाहर निकलने से पहले उन्हें कॉपी करें, नहीं तो पिछली बार सहेजने के बाद टाइप किया गया सब खो जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiale prima di uscire, altrimenti ciò che è stato digitato dall’ultimo salvataggio andrà perso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終了する前にコピーしてください。コピーしないと、最後に保存してから入力した内容は失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "종료하기 전에 복사하십시오. 그렇지 않으면 마지막 저장 이후 입력한 내용이 사라집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieer ze voordat je stopt, anders gaat wat je sinds de laatste bewaaractie hebt getypt verloren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skopiuj je przed zakończeniem, w przeciwnym razie tekst wpisany od ostatniego zachowania zostanie utracony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie-as antes de encerrar, ou o que foi digitado desde o último salvamento será perdido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопируйте их перед завершением, иначе текст, введённый после последнего сохранения, будет потерян."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çıkmadan önce onları kopyalayın; aksi takdirde son kaydetmeden bu yana yazılanlar kaybolur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопіюйте їх перед виходом, інакше введене після останнього збереження буде втрачено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在退出前拷贝，否则自上次存储以来输入的内容将会丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在結束前拷貝，否則上次儲存後輸入的內容將會遺失。"
          }
        }
      }
    },
