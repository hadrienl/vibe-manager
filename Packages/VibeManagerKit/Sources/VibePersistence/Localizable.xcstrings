    "The session store is damaged and no valid backup is available." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملف الجلسات تالف ولا تتوفر نسخة احتياطية صالحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
