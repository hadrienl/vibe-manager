    },
    "The session store is healthy, so there is nothing to restore." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملف الجلسات سليم، لذا لا يوجد ما يجب استعادته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
