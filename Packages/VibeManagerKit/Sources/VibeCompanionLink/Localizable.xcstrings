    "“%@” sent a test at %@.\nReceived at %@, %@ later." : {
      "comment" : "The alert of a test from the phone. The phone's name, the time it sent the test, the time the Mac received it, and the delay between them.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل «%1$@» اختبارًا في %2$@.\nتم استلامه في %3$@، بعد %4$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ hat um %2$@ einen Test gesendet.\nEmpfangen um %3$@, %4$@ später."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» envió una prueba a las %2$@.\nRecibida a las %3$@, %4$@ después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » a envoyé un test à %2$@.\nReçu à %3$@, %4$@ plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” ने %2$@ पर एक परीक्षण भेजा।\n%3$@ पर मिला, %4$@ बाद।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» ha inviato un test alle %2$@.\nRicevuto alle %3$@, %4$@ dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」が%2$@にテストを送信しました。\n%3$@に受信（%4$@後）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’에서 %2$@에 테스트를 보냈습니다.\n%3$@에 받음(%4$@ 후)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’ heeft om %2$@ een test gestuurd.\nOntvangen om %3$@, %4$@ later."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@” wysłał test o %2$@.\nOdebrano o %3$@, %4$@ później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” enviou um teste às %2$@.\nRecebido às %3$@, %4$@ depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» отправил тест в %2$@.\nПолучен в %3$@, через %4$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” saat %2$@ itibarıyla bir test gönderdi.\nSaat %3$@ itibarıyla, %4$@ sonra alındı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» надіслав тест о %2$@.\nОтримано о %3$@, через %4$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”在 %2$@ 发送了一个测试。\n于 %3$@ 收到，延迟 %4$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」在 %2$@ 傳送了一個測試。\n於 %3$@ 收到，延遲 %4$@。"
          }
        }
      }
