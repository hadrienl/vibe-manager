    "Read Last Output, Control-Option-Command-O, reads the last lines the agent wrote." : {
      "comment" : "Read Last Output is a command of the View menu.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«قراءة آخر مخرجات»، Control-Option-Command-O، يقرأ آخر الأسطر التي كتبها الوكيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letzte Ausgabe vorlesen, Control-Option-Befehl-O, liest die letzten vom Agent geschriebenen Zeilen vor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer la última salida, Control-Opción-Comando-O, lee las últimas líneas que escribió el agente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lire la dernière sortie, Contrôle-Option-Commande-O, lit les dernières lignes écrites par l’agent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अंतिम आउटपुट पढ़ें, Control-Option-Command-O, एजेंट द्वारा लिखी गई अंतिम पंक्तियाँ पढ़ता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggi ultimo output, Ctrl-Opzione-Comando-O, legge le ultime righe scritte dall’agente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「最後の出力を読み上げる」（Control-Option-Command-O）で、エージェントが最後に出力した行を読み上げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막 출력 읽기(Control-Option-Command-O)는 에이전트가 마지막으로 작성한 행을 읽어 줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lees laatste uitvoer, Control-Option-Command-O, leest de laatste regels die de agent schreef."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odczytaj ostatnie wyjście, Control-Option-Command-O, odczytuje ostatnie wiersze napisane przez agenta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ler Última Saída, Control-Option-Command-O, lê as últimas linhas escritas pelo agente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Прочитать последний вывод», Control-Option-Command-O, зачитывает последние строки, написанные агентом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son Çıktıyı Oku (Control-Option-Command-O), ajanın yazdığı son satırları okur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Прочитати останній вивід», Control-Option-Command-O, читає останні рядки, написані агентом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“朗读最后输出”（Control-Option-Command-O）会朗读智能体最后写入的几行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「朗讀最後輸出」（Control-Option-Command-O）會朗讀代理程式最後寫出的幾行。"
          }
        }
      }
    },
