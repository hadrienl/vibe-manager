    "Its key is not in the keychain. Add it in Settings → Endpoints." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاحها غير موجود في سلسلة المفاتيح. أضفه في الإعدادات → نقاط النهاية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sein Schlüssel ist nicht im Schlüsselbund. Füge ihn unter Einstellungen → Endpoints hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su clave no está en el llavero. Añádela en Ajustes → Endpoints."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa clé n’est pas dans le trousseau. Ajoutez-la dans Réglages → Endpoints."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसकी कुंजी कीचेन में नहीं है। इसे सेटिंग्ज़ → एंडपॉइंट में जोड़ें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sua chiave non è nel portachiavi. Aggiungila in Impostazioni → Endpoint."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーがキーチェーンにありません。「設定」→「エンドポイント」で追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키가 키체인에 없습니다. 설정 → 엔드포인트에서 추가하십시오."
