    "Summarize the conversation to free up context." : {
      "comment" : "Codex's /compact command, in the composer's list.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يلخّص المحادثة لتحرير مساحة من السياق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasst die Unterhaltung zusammen, um Kontext freizugeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resume la conversación para liberar contexto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résume la conversation pour libérer du contexte."
          }
        },
        "hi" : {
