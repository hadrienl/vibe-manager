{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@ is older than the required %@." : {
      "comment" : "An agent's name, then two version numbers.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ is older than the required %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ est plus ancien que la version requise, %3$@."
          }
        }
      }
    },
    "%@ could not be inspected." : {
      "comment" : "An agent's name.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas pu être examiné."
          }
        }
      }
    },
    "%@ did not answer in time." : {
      "comment" : "An agent's name.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas répondu à temps."
          }
        }
      }
    },
    "%@ drives this endpoint: %@" : {
      "comment" : "The harness's name, then why it cannot run.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ pilote cet endpoint : %2$@"
          }
        }
      }
    },
    "%@ is installed but not signed in." : {
      "comment" : "An agent's name.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est installé, mais vous n’y êtes pas connecté."
          }
        }
      }
    },
    "%@ is ready." : {
      "comment" : "An agent's name.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est prêt."
          }
        }
      }
    },
    "%@ was not found on this Mac." : {
      "comment" : "An agent's name.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est introuvable sur ce Mac."
          }
        }
      }
    },
