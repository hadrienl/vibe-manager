    "No model of this endpoint can call tools. Add one in Settings → Endpoints." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد نموذج في نقطة النهاية هذه قادر على استدعاء الأدوات. أضف واحدًا في الإعدادات → نقاط النهاية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Modell dieses Endpoints kann Tools aufrufen. Füge eines unter Einstellungen → Endpoints hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún modelo de este endpoint puede llamar a herramientas. Añade uno en Ajustes → Endpoints."
