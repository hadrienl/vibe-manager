            "value" : "La commande %@ existe, mais ne peut pas être exécutée."
          }
        }
      }
    },
    "The endpoint did not answer. Attempt %lld of %lld in %lld s." : {
      "comment" : "A wait before another attempt: its number, how many at most, the seconds left.",
