                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld modèles"
                }
              }
            }
          }
        }
      }
    },
    "Create an AGENTS.md file with instructions for Codex." : {
      "comment" : "Codex's /init command, in the composer's list.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée un fichier AGENTS.md avec des instructions pour Codex."
          }
        }
      }
    },
    "Endpoint via %@" : {
      "comment" : "The coding agent that drives an endpoint.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endpoint via %@"
          }
        }
      }
    },
    "Its key is not in the keychain. Add it in Settings → Endpoints." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa clé n’est pas dans le trousseau. Ajoutez-la dans Réglages → Endpoints."
          }
        }
      }
    },
    "Its last test failed. Test it again in Settings → Endpoints." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son dernier test a échoué. Testez-le à nouveau dans Réglages → Endpoints."
          }
        }
      }
    },
    "No model of this endpoint can call tools. Add one in Settings → Endpoints." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun modèle de cet endpoint ne sait appeler d’outils. Ajoutez-en un dans Réglages → Endpoints."
          }
        }
      }
    },
    "Summarize the conversation to free up context." : {
      "comment" : "Codex's /compact command, in the composer's list.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résume la conversation pour libérer du contexte."
          }
        }
      }
    },
    "The %@ check was interrupted." : {
      "comment" : "An agent's name.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vérification de %@ a été interrompue."
          }
        }
