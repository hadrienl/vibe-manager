    "The endpoint did not answer. Attempt %lld of %lld in %lld s." : {
      "comment" : "A wait before another attempt: its number, how many at most, the seconds left.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تستجب نقطة النهاية. المحاولة %1$lld من %2$lld خلال %3$lld ث."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Endpoint hat nicht geantwortet. Versuch %lld von %lld in %lld s."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El endpoint no ha respondido. Intento %lld de %lld en %lld s."
          }
