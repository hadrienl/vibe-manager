{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@ is older than the required %@." : {
      "comment" : "An agent's name, then two version numbers.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ is older than the required %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ est plus ancien que la version requise, %3$@."
          }
        }
      }
    },
    "%@ could not be inspected." : {
      "comment" : "An agent's name.",
