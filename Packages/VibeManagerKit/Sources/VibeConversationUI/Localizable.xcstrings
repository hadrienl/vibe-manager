    },
    "%@ is making the theme…" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ compose le thème…"
          }
        }
      }
    },
    "%@ is no longer installed: the theme's font is used." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est plus installée : la police du thème est utilisée."
