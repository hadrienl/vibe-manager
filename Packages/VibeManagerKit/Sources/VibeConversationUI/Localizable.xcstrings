    "No agent available can draw the picture: the theme is on trial without it. Codex draws pictures." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد وكيل متوفر قادر على رسم الصورة: تتم تجربة السمة بدونها. يستطيع Codex رسم الصور."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein verfügbarer Agent kann das Bild zeichnen: Das Design wird ohne Bild ausprobiert. Codex zeichnet Bilder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún agente disponible puede dibujar la imagen: el tema está a prueba sin ella. Codex dibuja imágenes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun agent disponible ne sait dessiner l’image : le thème est à l’essai sans elle. Codex dessine des images."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई भी उपलब्ध एजेंट चित्र नहीं बना सकता: थीम उसके बिना आज़माई जा रही है। Codex चित्र बनाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun agente disponibile può disegnare l’immagine: il tema è in prova senza di essa. Codex disegna immagini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像を描画できるエージェントがありません。画像なしでテーマを試用中です。画像はCodexで描画できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그림을 그릴 수 있는 에이전트가 없어 그림 없이 테마를 시험 적용 중입니다. Codex는 그림을 그릴 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen beschikbare agent kan de afbeelding tekenen: het thema wordt zonder afbeelding uitgeprobeerd. Codex tekent afbeeldingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żaden dostępny agent nie umie narysować obrazu: motyw jest testowany bez niego. Codex rysuje obrazy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum agente disponível consegue desenhar a imagem: o tema está em teste sem ela. O Codex desenha imagens."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ни один доступный агент не умеет рисовать изображение: тема опробуется без него. Изображения рисует Codex."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanılabilir hiçbir ajan resmi çizemiyor: tema resimsiz olarak deneniyor. Codex resim çizebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жоден доступний агент не вміє малювати зображення: тему застосовано на пробу без нього. Зображення малює Codex."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有可绘制图片的可用智能体：正在试用不含图片的主题。Codex 可以绘制图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有可用的代理程式能繪製圖片：主題將在沒有圖片的情況下試用。Codex 可以繪製圖片。"
          }
        }
      }
    },
