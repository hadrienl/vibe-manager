    "Speak closer to the microphone, or check the input chosen in System Settings › Sound." : {
      "comment" : "Under “Nothing was heard.”",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحدّث أقرب إلى الميكروفون، أو تحقق من الإدخال المختار في إعدادات النظام › الصوت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich näher am Mikrofon oder prüfe den Eingang unter „Systemeinstellungen“ › „Ton“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habla más cerca del micrófono o comprueba la entrada elegida en Ajustes del Sistema › Sonido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parlez plus près du micro, ou vérifiez l’entrée choisie dans Réglages Système › Son."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माइक्रोफ़ोन के पास बोलें, या सिस्टम सेटिंग्ज़ › ध्वनि में चुना गया इनपुट जाँचें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parla più vicino al microfono o controlla l’ingresso scelto in Impostazioni di Sistema › Suono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクに近づいて話すか、「システム設定」›「サウンド」で選択されている入力を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크에 더 가까이 말하거나 시스템 설정 › 사운드에서 선택된 입력을 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spreek dichter bij de microfoon of controleer de invoer in Systeeminstellingen › Geluid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mów bliżej mikrofonu lub sprawdź wejście wybrane w Ustawieniach systemowych › Dźwięk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fale mais perto do microfone ou verifique a entrada escolhida em Ajustes do Sistema › Som."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Говорите ближе к микрофону или проверьте выбранный вход в «Системных настройках» › «Звук»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofona daha yakın konuşun veya Sistem Ayarları › Ses'te seçili girişi kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Говоріть ближче до мікрофона або перевірте вибраний вхід у «Системних параметрах» › «Звук»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请靠近麦克风说话，或检查“系统设置”›“声音”中选择的输入设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
