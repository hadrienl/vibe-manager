    "In light mode: %@. In dark mode: %@. Choosing a theme gives it to the mode macOS is in." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في الوضع الفاتح: %1$@. في الوضع الداكن: %2$@. اختيار سمة يعيّنها للوضع الحالي في macOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im hellen Modus: %1$@. Im dunklen Modus: %2$@. Ein gewähltes Design gilt für den aktuellen Modus von macOS."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In light mode: %1$@. In dark mode: %2$@. Choosing a theme gives it to the mode macOS is in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el modo claro: %1$@. En el modo oscuro: %2$@. Al elegir un tema, se asigna al modo actual de macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mode clair : %1$@. En mode sombre : %2$@. Choisir un thème l’attribue au mode actuel de macOS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइट मोड में: %1$@। डार्क मोड में: %2$@। थीम चुनने पर वह macOS के मौजूदा मोड को दी जाती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In modalità chiara: %1$@. In modalità scura: %2$@. Scegliere un tema lo assegna alla modalità attuale di macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライトモード：%1$@。ダークモード：%2$@。テーマを選択すると、macOSの現在のモードに割り当てられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이트 모드: %1$@. 다크 모드: %2$@. 테마를 선택하면 macOS의 현재 모드에 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In lichte modus: %1$@. In donkere modus: %2$@. Een gekozen thema geldt voor de modus waarin macOS nu staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W trybie jasnym: %1$@. W trybie ciemnym: %2$@. Wybrany motyw zostaje przypisany do bieżącego trybu macOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No modo claro: %1$@. No modo escuro: %2$@. Escolher um tema o atribui ao modo atual do macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В светлом режиме: %1$@. В тёмном режиме: %2$@. Выбранная тема назначается текущему режиму macOS."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açık modda: %1$@. Koyu modda: %2$@. Seçtiğiniz tema, macOS’in o anki moduna atanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У світлому режимі: %1$@. У темному режимі: %2$@. Вибрана тема призначається поточному режиму macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浅色模式：%1$@。深色模式：%2$@。选择的主题将用于 macOS 当前所处的模式。"
          }
        },
        "zh-Hant" : {
