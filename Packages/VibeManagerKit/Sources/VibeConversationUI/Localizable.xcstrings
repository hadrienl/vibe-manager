{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ asks for your permission" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ demande votre autorisation"
          }
        }
      }
    },
    "%@ can no longer be found. Check that it is installed, then try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est introuvable. Vérifiez qu’il est installé, puis réessayez."
          }
        }
      }
    },
    "%@ could not draw the picture: the theme is on trial without it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas pu dessiner l’image : le thème est à l’essai sans elle."
          }
        }
      }
    },
    "%@ could not make the theme. The theme on screen is unchanged." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas pu créer le thème. Le thème affiché ne change pas."
          }
        }
      }
    },
    "%@ did not answer in time. The theme on screen is unchanged." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas répondu à temps. Le thème affiché ne change pas."
          }
        }
      }
    },
    "%@ has no shell mode: sent as a message" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas de mode shell : envoyé comme message"
          }
        }
      }
    },
    "%@ has not written anything yet." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a encore rien écrit."
          }
        }
      }
    },
    "%@ in %@’s terminal" : {
      "comment" : "A command, then the agent's name, as VoiceOver reads the panel.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ dans le terminal de %2$@"
          }
        }
      }
    },
    "%@ is asking you a question" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vous pose une question"
          }
        }
      }
    },
    "%@ is changing the theme." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ modifie le thème."
          }
        }
      }
    },
    "%@ is changing the theme…" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ modifie le thème…"
          }
        }
      }
    },
    "%@ is deleted." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est supprimé."
          }
        }
      }
    },
    "%@ is drawing the picture." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dessine l’image de fond."
          }
        }
      }
    },
    "%@ is drawing the picture… It takes a minute or two." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dessine l’image de fond… Cela prend une à deux minutes."
          }
        }
      }
    },
    "%@ is making the theme." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ compose le thème."
          }
        }
