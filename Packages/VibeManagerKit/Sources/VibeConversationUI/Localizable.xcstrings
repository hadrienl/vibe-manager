    "%@ in %@’s terminal" : {
      "comment" : "A command, then the agent's name, as VoiceOver reads the panel.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ في طرفية %2$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ im Terminal von %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ en el terminal de %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
