{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ asks for your permission" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطلب %@ إذنك"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bittet um deine Erlaubnis"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ te pide permiso"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ demande votre autorisation"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ आपकी अनुमति माँग रहा है"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ chiede la tua autorizzazione"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が許可を求めています"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 권한을 요청합니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vraagt om je toestemming"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ prosi o Twoje pozwolenie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pede sua permissão"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ запрашивает ваше разрешение"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ izninizi istiyor"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ запитує ваш дозвіл"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 请求你的许可"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在請求你的許可"
          }
        }
      }
    },
    "%@ can no longer be found. Check that it is installed, then try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذّر العثور على %@. تحقق من أنه مثبّت، ثم حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde nicht gefunden. Prüfe, ob es installiert ist, und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encuentra %@. Comprueba que esté instalado y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est introuvable. Vérifiez qu’il est installé, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ अब नहीं मिल रहा। जाँचें कि यह इंस्टॉल है, फिर से कोशिश करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è più disponibile. Verifica che sia installato, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が見つかりません。インストールされていることを確認してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 찾을 수 없습니다. 설치되어 있는지 확인한 후 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is niet meer te vinden. Controleer of het is geïnstalleerd en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można już znaleźć %@. Sprawdź, czy jest zainstalowany, i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não foi encontrado. Verifique se está instalado e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не найден. Убедитесь, что он установлен, и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ artık bulunamıyor. Yüklü olduğunu denetleyin, sonra yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдається знайти %@. Переконайтеся, що його інстальовано, і спробуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到 %@。请确认它已安装，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到 %@。請確認已安裝，然後再試一次。"
          }
        }
      }
    },
    "%@ could not draw the picture: the theme is on trial without it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على %@ رسم الصورة: تتم تجربة السمة بدونها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte das Bild nicht zeichnen: Das Design wird ohne Bild ausprobiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no ha podido dibujar la imagen: el tema está a prueba sin ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas pu dessiner l’image : le thème est à l’essai sans elle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ चित्र नहीं बना सका: थीम उसके बिना आज़माई जा रही है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è riuscito a disegnare l’immagine: il tema è in prova senza di essa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は画像を描画できませんでした。画像なしでテーマを試用中です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 그림을 그리지 못했습니다. 그림 없이 테마를 시험 적용 중입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kon de afbeelding niet tekenen: het thema wordt zonder afbeelding uitgeprobeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie zdołał narysować obrazu: motyw jest testowany bez niego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não conseguiu desenhar a imagem: o tema está em teste sem ela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не смог нарисовать изображение: тема опробуется без него."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ resmi çizemedi: tema resimsiz olarak deneniyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не вдалося намалювати зображення: тему застосовано на пробу без нього."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法绘制图片：正在试用不含图片的主题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 無法繪製圖片：主題將在沒有圖片的情況下試用。"
          }
        }
      }
    },
    "%@ could not make the theme. The theme on screen is unchanged." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على %@ إنشاء السمة. لم تتغير السمة المعروضة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte das Design nicht erstellen. Das angezeigte Design bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no ha podido crear el tema. El tema en pantalla no cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas pu créer le thème. Le thème affiché ne change pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ थीम नहीं बना सका। स्क्रीन पर दिख रही थीम नहीं बदली।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è riuscito a creare il tema. Il tema sullo schermo non cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はテーマを作成できませんでした。表示中のテーマは変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 테마를 만들지 못했습니다. 화면의 테마는 변경되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kon het thema niet maken. Het thema op het scherm blijft ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie zdołał utworzyć motywu. Motyw na ekranie pozostaje bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não conseguiu criar o tema. O tema na tela não foi alterado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не смог создать тему. Тема на экране не изменилась."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ temayı oluşturamadı. Ekrandaki tema değişmedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не вдалося створити тему. Тема на екрані не змінилася."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法制作主题。屏幕上的主题保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 無法製作主題。畫面上的主題維持不變。"
          }
        }
      }
    },
    "%@ did not answer in time. The theme on screen is unchanged." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يستجب %@ في الوقت المحدد. لم تتغير السمة المعروضة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat nicht rechtzeitig geantwortet. Das angezeigte Design bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no ha respondido a tiempo. El tema en pantalla no cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas répondu à temps. Le thème affiché ne change pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ने समय पर उत्तर नहीं दिया। स्क्रीन पर दिख रही थीम नहीं बदली।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non ha risposto in tempo. Il tema sullo schermo non cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が時間内に応答しませんでした。表示中のテーマは変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 제시간에 응답하지 않았습니다. 화면의 테마는 변경되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reageerde niet op tijd. Het thema op het scherm blijft ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie odpowiedział na czas. Motyw na ekranie pozostaje bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não respondeu a tempo. O tema na tela não foi alterado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не ответил вовремя. Тема на экране не изменилась."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zamanında yanıt vermedi. Ekrandaki tema değişmedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не відповів вчасно. Тема на екрані не змінилася."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未及时响应。屏幕上的主题保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未及時回應。畫面上的主題維持不變。"
          }
        }
      }
    },
    "%@ has no shell mode: sent as a message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتوفر في %@ وضع shell: أُرسل كرسالة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
