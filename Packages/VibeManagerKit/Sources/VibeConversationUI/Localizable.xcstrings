    "The theme applies to the conversation view of every session. The terminal keeps the colours the agent sends it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنطبق السمة على عرض المحادثة في كل الجلسات. تحتفظ الطرفية بالألوان التي يرسلها إليها الوكيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Design gilt für die Unterhaltungsansicht aller Sitzungen. Das Terminal behält die Farben, die der Agent ihm sendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tema se aplica a la vista de conversación de todas las sesiones. El terminal conserva los colores que le envía el agente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le thème s’applique à la vue conversation de toutes les sessions. Le terminal garde les couleurs que l’agent lui envoie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "थीम हर सेशन के बातचीत दृश्य पर लागू होती है। टर्मिनल वही रंग रखता है जो एजेंट उसे भेजता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tema si applica alla vista conversazione di ogni sessione. Il terminale mantiene i colori che gli invia l’agente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テーマはすべてのセッションの会話ビューに適用されます。ターミナルはエージェントから送られる色のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "테마는 모든 세션의 대화 보기에 적용됩니다. 터미널은 에이전트가 보내는 색상을 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het thema geldt voor de gespreksweergave van elke sessie. De terminal behoudt de kleuren die de agent stuurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motyw dotyczy widoku rozmowy każdej sesji. Terminal zachowuje kolory, które wysyła mu agent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tema se aplica à visualização de conversa de todas as sessões. O terminal mantém as cores que o agente envia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тема применяется к виду беседы во всех сессиях. Терминал сохраняет цвета, которые ему передаёт агент."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tema, tüm oturumların konuşma görünümüne uygulanır. Terminal, ajanın gönderdiği renkleri korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тема застосовується до вигляду розмови всіх сеансів. Термінал зберігає кольори, які надсилає агент."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主题适用于所有会话的对话视图。终端保留智能体发送给它的颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主題會套用至所有工作階段的對話視圖。終端機則保留代理程式傳送的顏色。"
          }
        }
      }
    },
