    "It is used in dark mode: the conversations go back to %@. Its file is deleted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنها مستخدمة في الوضع الداكن: ستعود المحادثات إلى %@. سيتم حذف ملفها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird im dunklen Modus verwendet: Die Unterhaltungen kehren zu %@ zurück. Seine Datei wird gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa en el modo oscuro: las conversaciones volverán a %@. Su archivo se eliminará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est utilisé en mode sombre : les conversations reprendront %@. Son fichier sera supprimé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह डार्क मोड में उपयोग हो रही है: बातचीत %@ पर लौट जाएगी। इसकी फ़ाइल डिलीट कर दी जाएगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È usato in modalità scura: le conversazioni torneranno a %@. Il suo file verrà eliminato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このテーマはダークモードで使用中です。会話は%@に戻ります。ファイルは削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다크 모드에서 사용 중인 테마입니다. 대화는 %@(으)로 돌아갑니다. 파일은 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wordt gebruikt in de donkere modus: de gesprekken gaan terug naar %@. Het bestand wordt verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jest używany w trybie ciemnym: rozmowy wrócą do motywu %@. Jego plik zostanie usunięty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele é usado no modo escuro: as conversas voltarão a %@. O arquivo dele será apagado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Она используется в тёмном режиме: беседы вернутся к теме %@. Её файл будет удалён."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu tema koyu modda kullanılıyor: konuşmalar %@ temasına döner. Dosyası silinir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вона використовується в темному режимі: розмови повернуться до %@. Її файл буде видалено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它正用于深色模式：对话将恢复为 %@。它的文件将被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它正用於深色模式：對話將改回 %@。其檔案將被刪除。"
          }
        }
      }
    },
    "It is used in light and dark mode: the conversations go back to %@ and %@. Its file is deleted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنها مستخدمة في الوضعين الفاتح والداكن: ستعود المحادثات إلى %1$@ و%2$@. سيتم حذف ملفها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird im hellen und dunklen Modus verwendet: Die Unterhaltungen kehren zu %1$@ und %2$@ zurück. Seine Datei wird gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
