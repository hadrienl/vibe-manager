    "A forest at night: moss greens, quiet, easy on the eyes…" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غابة ليلًا: أخضر طحلبي، هادئة، مريحة للعين…"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wald bei Nacht: Moosgrün, ruhig, angenehm für die Augen …"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bosque de noche: verdes musgo, sobrio, descansado para la vista…"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une forêt la nuit : verts mousse, sobre, reposant pour les yeux…"
