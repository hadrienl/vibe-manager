    "The agent stopped on an error. Its terminal says why." : {
      "comment" : "Under a conversation whose agent ended on its own, not closed by the user.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف الوكيل بسبب خطأ. توضح طرفيته السبب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Agent wurde wegen eines Fehlers beendet. Sein Terminal zeigt den Grund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El agente se ha detenido por un error. Su terminal indica el motivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’agent s’est arrêté sur une erreur. Son terminal dit pourquoi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एजेंट एक त्रुटि पर रुक गया। इसका टर्मिनल कारण बताता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’agente si è arrestato per un errore. Il suo terminale indica il motivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エラーによりエージェントが停止しました。原因はターミナルに表示されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 오류로 중단되었습니다. 원인은 터미널에서 확인할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De agent is gestopt door een fout. De terminal vertelt waarom."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent zatrzymał się z powodu błędu. Przyczynę podaje jego terminal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O agente parou devido a um erro. O terminal dele mostra o motivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агент остановился из-за ошибки. Причина указана в его терминале."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajan bir hata nedeniyle durdu. Nedeni terminalinde yazıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агент зупинився через помилку. Причину видно в його терміналі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能体因错误而停止。可在其终端中查看原因。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代理程式因錯誤而停止。請查看其終端機了解原因。"
          }
        }
      }
    },
    "The first answer could not be used: it is asked once more." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر استخدام الإجابة الأولى: يُطلب من الوكيل مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die erste Antwort war unbrauchbar: Der Agent wird erneut gefragt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera respuesta no se ha podido usar: se vuelve a pedir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première réponse était inutilisable : l’agent est sollicité une seconde fois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहला उत्तर उपयोग नहीं किया जा सका: एक बार और पूछा जा रहा है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prima risposta non era utilizzabile: viene richiesta ancora una volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の回答は使用できませんでした。もう一度問い合わせています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 번째 답변을 사용할 수 없어 다시 한 번 요청합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het eerste antwoord was onbruikbaar: er wordt nog een keer om gevraagd."
