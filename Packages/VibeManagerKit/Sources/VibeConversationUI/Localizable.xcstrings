    "%@ twice gave a theme that could not be read. The theme on screen is unchanged: try again, or say it differently." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قدّم %@ مرتين سمة غير قابلة للقراءة. لم تتغير السمة المعروضة: حاول مرة أخرى، أو صِغ طلبك بشكل مختلف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat zweimal ein unlesbares Design geliefert. Das angezeigte Design bleibt unverändert: Versuche es erneut oder formuliere es anders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha devuelto dos veces un tema ilegible. El tema en pantalla no cambia: vuelve a intentarlo o descríbelo de otra forma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a rendu deux fois un thème illisible. Le thème affiché ne change pas : réessayez, ou formulez la demande autrement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ने दो बार ऐसी थीम दी जो पढ़ी नहीं जा सकी। स्क्रीन पर दिख रही थीम नहीं बदली: फिर से कोशिश करें, या अलग तरीके से कहें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha restituito due volte un tema illeggibile. Il tema sullo schermo non cambia: riprova o formula la richiesta in un altro modo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が2回続けて読み込めないテーマを返しました。表示中のテーマは変更されません。もう一度試すか、別の言い方でお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 두 번 연속 읽을 수 없는 테마를 반환했습니다. 화면의 테마는 변경되지 않습니다. 다시 시도하거나 다르게 표현해 보십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ leverde twee keer een onleesbaar thema op. Het thema op het scherm blijft ongewijzigd: probeer het opnieuw of formuleer het anders."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dwukrotnie zwrócił nieczytelny motyw. Motyw na ekranie pozostaje bez zmian: spróbuj ponownie lub sformułuj prośbę inaczej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ devolveu duas vezes um tema ilegível. O tema na tela não foi alterado: tente novamente, ou descreva de outra forma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ дважды выдал нечитаемую тему. Тема на экране не изменилась: повторите попытку или сформулируйте иначе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ iki kez okunamayan bir tema verdi. Ekrandaki tema değişmedi: yeniden deneyin ya da farklı biçimde ifade edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ двічі повернув тему, яку неможливо прочитати. Тема на екрані не змінилася: спробуйте ще раз або сформулюйте інакше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 两次给出了无法读取的主题。屏幕上的主题保持不变：请重试，或换一种说法。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 兩次都給出無法讀取的主題。畫面上的主題維持不變：請再試一次，或換個方式描述。"
          }
        }
      }
    },
