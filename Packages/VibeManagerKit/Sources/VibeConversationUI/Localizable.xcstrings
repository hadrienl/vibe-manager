    "The theme could not be used as it was: it is asked again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر استخدام السمة كما هي: يتم طلبها مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Design war so nicht verwendbar: Es wird erneut angefordert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tema no se podía usar tal cual: se vuelve a pedir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le thème était inutilisable tel quel : il est redemandé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "थीम जैसी थी वैसी उपयोग नहीं की जा सकी: फिर से माँगी जा रही है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tema non era utilizzabile così com’era: viene richiesto di nuovo."
          }
        },
