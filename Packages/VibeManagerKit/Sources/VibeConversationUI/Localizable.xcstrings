          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один тест падает на **заменённом** файле: сначала сравниваю `inode`."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
