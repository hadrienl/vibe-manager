    "Describe a theme to an agent, and see each version applied" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صِف سمة لوكيل، وشاهد كل إصدار مطبّقًا"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschreibe einem Agent ein Design und sieh jede Version angewendet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe un tema a un agente y mira cada versión aplicada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décrire un thème à un agent, et voir chaque version appliquée"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी एजेंट को थीम का वर्णन करें, और हर संस्करण लागू होते देखें"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descrivi un tema a un agente e guarda ogni versione applicata"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントにテーマを説明し、各バージョンが適用されるのを確認できます"
