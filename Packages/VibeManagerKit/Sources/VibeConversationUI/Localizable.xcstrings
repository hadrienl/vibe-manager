    "Install Claude Code or Codex and sign in from a terminal, then check again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت Claude Code أو Codex وسجّل الدخول من طرفية، ثم تحقق مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiere Claude Code oder Codex, melde dich in einem Terminal an und prüfe dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala Claude Code o Codex e inicia sesión desde un terminal; luego vuelve a comprobarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez Claude Code ou Codex et connectez-vous depuis un terminal, puis vérifiez à nouveau."
          }
