          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нічний ліс: відтінки моху, спокійно, не втомлює очі…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜晚的森林：苔绿色调，安静，看着舒服…"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
