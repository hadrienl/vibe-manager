    "%@ is signed out. Sign in from a terminal, then try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est déconnecté. Connectez-vous depuis un terminal, puis réessayez."
          }
        }
      }
    },
    "%@ is starting. If it asks something first, answer in the terminal." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ démarre. S’il pose une question d’abord, répondez dans le terminal."
          }
        }
      }
    },
    "%@ is too old to make a theme. Update it, then try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
