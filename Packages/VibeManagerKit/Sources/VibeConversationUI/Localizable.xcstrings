        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트에게 테마를 설명하고 각 버전이 적용되는 모습을 확인합니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschrijf een thema aan een agent en zie elke versie toegepast"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opisz motyw agentowi i zobacz zastosowanie każdej wersji"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descreva um tema a um agente e veja cada versão aplicada"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
