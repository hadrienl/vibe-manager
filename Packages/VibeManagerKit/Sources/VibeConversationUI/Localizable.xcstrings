        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 너무 오래되어 테마를 만들 수 없습니다. 업데이트한 후 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is te oud om een thema te maken. Werk het bij en probeer het opnieuw."
