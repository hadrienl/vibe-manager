    "Otherwise your accent, %@, replaces the one generated." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وإلا فإن لون التمييز الخاص بك (%@) يحل محل اللون المُنشأ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andernfalls ersetzt dein Akzent (%@) den generierten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no, tu resalte (%@) sustituye al del tema generado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinon, votre accent (%@) remplace celui du thème généré."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अन्यथा आपका एक्सेंट, %@, जनरेट किए गए एक्सेंट की जगह ले लेता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altrimenti il tuo accento, %@, sostituisce quello generato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフの場合は、あなたのアクセント（%@）が生成されたものの代わりに使われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그렇지 않으면 사용자의 강조 색상(%@)이 생성된 강조 색상을 대체합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anders vervangt je accent (%@) het gegenereerde accent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W przeciwnym razie Twój akcent (%@) zastępuje wygenerowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caso contrário, seu destaque (%@) substitui o do tema gerado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Иначе ваш акцент (%@) заменит созданный."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aksi takdirde sizin vurgu renginiz (%@) oluşturulanın yerini alır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Інакше ваш акцент (%@) замінює згенерований."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "否则，你的强调色（%@）将替换生成的强调色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "否則，你的強調色（%@）會取代產生的強調色。"
          }
        }
      }
    },
