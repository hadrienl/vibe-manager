    "Shorten it: it is shown whole in the sidebar and in the window's title." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختصره: فهو يظهر كاملًا في الشريط الجانبي وفي عنوان النافذة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kürze ihn: Er wird vollständig in der Seitenleiste und im Fenstertitel angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acórtalo: se muestra completo en la barra lateral y en el título de la ventana."
          }
        },
        "fr" : {
