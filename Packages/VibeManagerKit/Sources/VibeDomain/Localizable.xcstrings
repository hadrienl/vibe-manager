    "Merge some of them, or write the parts that never change as text." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادمج بعضها، أو اكتب الأجزاء التي لا تتغير أبدًا كنص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasse einige zusammen oder schreibe die unveränderlichen Teile als Text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrupa algunos o escribe como texto las partes que nunca cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regroupez-en certains, ou écrivez en texte les parties qui ne changent jamais."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इनमें से कुछ को मिलाएँ, या जो हिस्से कभी नहीं बदलते उन्हें टेक्स्ट के रूप में लिखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
