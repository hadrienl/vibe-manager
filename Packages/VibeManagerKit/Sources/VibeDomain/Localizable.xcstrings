    "Remove them — they usually come with text pasted from a coloured terminal." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أزلها — فهي تأتي عادةً مع نص ملصوق من طرفية ملونة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entferne sie – sie stammen meist aus Text, der aus einem farbigen Terminal eingefügt wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimínalos: suelen venir con texto pegado desde un terminal en color."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimez-les : ils accompagnent souvent du texte collé depuis un terminal en couleur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन्हें हटाएँ — ये आमतौर पर रंगीन टर्मिनल से पेस्ट किए गए टेक्स्ट के साथ आते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovili: di solito accompagnano testo incollato da un terminale a colori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り除いてください。通常、カラー表示のターミナルからペーストしたテキストに含まれています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제거하십시오. 대개 색상이 있는 터미널에서 붙여넣은 텍스트에 포함되어 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijder ze: ze komen meestal mee met tekst die uit een gekleurde terminal is geplakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń je — zwykle pojawiają się w tekście wklejonym z kolorowego terminala."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remova-os — eles costumam vir com texto colado de um terminal colorido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалите их — обычно они попадают вместе с текстом, вставленным из цветного терминала."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunları kaldırın — genellikle renkli bir terminalden yapıştırılan metinle gelirler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вилучіть їх — зазвичай вони потрапляють разом із текстом, вставленим із кольорового термінала."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请移除它们 — 它们通常来自从彩色终端粘贴的文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請將其移除 — 它們通常來自從彩色終端機貼上的文字。"
          }
        }
      }
    },
    "Review" : {
      "comment" : "An example prompt template, and the start of the name of the sessions it starts.",
      "localizations" : {
        "ar" : {
