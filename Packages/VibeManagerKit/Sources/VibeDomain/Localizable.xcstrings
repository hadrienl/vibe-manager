          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いくつかをまとめるか、変わらない部分はテキストとして記述してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부를 합치거나, 변하지 않는 부분은 일반 텍스트로 작성하십시오."
