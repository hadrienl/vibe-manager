    "Sessions that run on it keep it until they are restarted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتفظ به الجلسات التي تستخدمه إلى أن تُعاد تشغيلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
