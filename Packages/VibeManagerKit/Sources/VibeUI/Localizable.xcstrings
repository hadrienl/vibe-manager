    },
    "The command or the question" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La commande ou la question"
          }
        }
      }
    },
    "The context window, in tokens." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
