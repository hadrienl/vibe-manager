{
  "sourceLanguage" : "en",
  "strings" : {
    " (%lld after relaunch)" : {
      "comment" : "How many of the resumes followed a relaunch of Vibe Manager. Keep the leading space.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " (%lld après relance)"
          }
        }
      }
    },
    "%@ (archived)" : {
      "comment" : "A session's name.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (archivée)"
          }
        }
      }
    },
    "%@ A new process will be started instead, and given this summary of what the session carries. You can edit it before it is sent." : {
      "comment" : "Why the conversation cannot be resumed, in one sentence.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Un nouveau processus sera lancé à la place, avec ce résumé de ce que contient la session. Vous pouvez le modifier avant son envoi."
          }
        }
      }
    },
    "%@ KiB" : {
      "comment" : "A size in kibibytes: “1.5 KiB”.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Kio"
          }
        }
      }
    },
    "%@ Nothing was stopped or closed." : {
      "comment" : "Why the application could not reattach to its agents, in one sentence.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Rien n’a été arrêté ni fermé."
          }
        }
      }
    },
    "%@ The file is left untouched, so nothing in it is lost." : {
      "comment" : "Why the notes could not be read, a sentence.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Le fichier est laissé intact : rien de ce qu’il contient n’est perdu."
          }
        }
      }
    },
    "%@ This agent takes no initial prompt either, so the new process starts without any summary of the session." : {
      "comment" : "Why the conversation cannot be resumed, in one sentence.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Cet agent n’accepte pas non plus de prompt initial : le nouveau processus démarre donc sans résumé de la session."
          }
        }
      }
    },
    "%@ asks for new hooks to be approved once. Vibe Manager approves these ones, and no other." : {
      "comment" : "What approving does; the argument is the agent's name.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ demande d’approuver une fois chaque nouveau hook. Vibe Manager approuve ceux-ci, et aucun autre."
          }
        }
      }
    },
    "%@ cache read" : {
      "comment" : "Tokens read from the cache, abbreviated: “1.2 M cache read”.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lus en cache"
          }
        }
      }
    },
    "%@ cache write" : {
      "comment" : "Tokens written to the cache, abbreviated: “80.0 k cache write”.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ écrits en cache"
          }
        }
      }
    },
    "%@ cannot summarize this session: it is not signed in." : {
      "comment" : "An agent's name.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas résumer cette session : il n’est pas connecté."
          }
        }
      }
    },
    "%@ cannot summarize this session: it offers no way to." : {
      "comment" : "An agent's name.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas résumer cette session : il n’en offre pas le moyen."
          }
        }
      }
    },
    "%@ cannot summarize this session: its command-line tool cannot be run." : {
      "comment" : "An agent's name.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas résumer cette session : son outil en ligne de commande ne peut pas être lancé."
          }
        }
      }
    },
    "%@ cannot summarize this session: its command-line tool is too old." : {
      "comment" : "An agent's name.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas résumer cette session : son outil en ligne de commande est trop ancien."
          }
        }
      }
    },
    "%@ changed" : {
      "comment" : "The name of an imported template that differs from the library's.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ modifié"
          }
        }
      }
    },
    "%@ could not be opened in %@. It was revealed instead." : {
      "comment" : "A file's name, then an editor's name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ could not be opened in %2$@. It was revealed instead."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ n’a pas pu être ouvert dans %2$@. Il a été affiché dans le Finder à la place."
          }
        }
      }
    },
    "%@ could not be started." : {
      "comment" : "An agent's name.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas pu être lancé."
          }
        }
      }
    },
    "%@ in" : {
      "comment" : "Input tokens, abbreviated: “12.3 k in”.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ en entrée"
          }
        }
      }
    },
    "%@ is multiline" : {
      "comment" : "A field's name.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sur plusieurs lignes"
          }
        }
      }
    },
    "%@ is not a field — names use letters, digits, - and _ — so it stays as text." : {
      "comment" : "What the user wrote between double braces.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas un champ — un nom utilise des lettres, des chiffres, - et _ — et reste donc du texte."
          }
        }
      }
    },
    "%@ is required" : {
      "comment" : "A field's name.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ obligatoire"
          }
        }
      }
    },
    "%@ is running and will be stopped. Whatever it is doing right now will be interrupted." : {
      "comment" : "An agent's name.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est en cours d’exécution et sera arrêté. Ce qu’il est en train de faire sera interrompu."
          }
        }
      }
    },
    "%@ moved to %@." : {
      "comment" : "A session's name, then a task status.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ moved to %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ déplacée vers « %2$@ »."
          }
        }
      }
    },
    "%@ no longer exists; its closest folder was revealed." : {
      "comment" : "A folder's name.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’existe plus ; le dossier le plus proche a été affiché."
          }
        }
      }
    },
    "%@ of %@" : {
      "comment" : "The size of the prompt, then the most an agent accepts: “1.2 KB of 128 KB”.\nThe summary's size, then the most an agent accepts.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sur %2$@"
          }
        }
      }
    },
    "%@ of %@ · From “%@”, revision %@" : {
      "comment" : "The prompt's size, the most an agent accepts, the template's name and revision.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@ · From “%3$@”, revision %4$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sur %2$@ · Issu de « %3$@ », révision %4$@"
          }
        }
      }
    },
    "%@ of upstream" : {
      "comment" : "How far a branch is from its upstream: “2 ahead, 1 behind”.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ par rapport à l’amont"
          }
        }
      }
    },
    "%@ out" : {
      "comment" : "Output tokens, abbreviated: “4.5 k out”.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ en sortie"
          }
        }
      }
    },
    "%@ over what an agent can be started with. Shorten the summary." : {
      "comment" : "A size, formatted: “120 bytes”, “1.5 KiB”.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de trop pour lancer un agent. Raccourcissez le résumé."
          }
        }
      }
    },
    "%@ starts a new conversation and takes no prompt: it will not see %@'s conversation, and nothing is sent to it." : {
      "comment" : "The new agent's name, then the current agent's name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ starts a new conversation and takes no prompt: it will not see %2$@'s conversation, and nothing is sent to it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ démarre une nouvelle conversation et ne reçoit aucun prompt : il ne verra pas la conversation de %2$@, et rien ne lui est envoyé."
          }
        }
      }
    },
    "%@ starts a new conversation. It will not see %@'s conversation — only the summary below." : {
      "comment" : "The new agent's name, then the current agent's name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ starts a new conversation. It will not see %2$@'s conversation — only the summary below."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ démarre une nouvelle conversation. Il ne verra pas la conversation de %2$@ — seulement le résumé ci-dessous."
          }
        }
      }
    },
    "%@ starts a new conversation. It will not see %@'s conversation, and no summary will be sent." : {
