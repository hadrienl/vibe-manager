    "Without a prompt, the agent starts with nothing to do." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون prompt، يبدأ الوكيل وليس لديه ما يفعله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Prompt startet der Agent ohne Aufgabe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
