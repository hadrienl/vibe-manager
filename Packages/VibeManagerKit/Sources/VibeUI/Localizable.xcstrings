          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初に一致した部分、またはグループがある場合は最初のグループ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
