            "value": "Notes"
          }
        }
      }
    },
    "Nothing is deleted: notes, repositories and Git metadata are kept, and the session stays readable under Closed. It can no longer be reopened until it is unarchived.": {
      "comment": "Closed is the tab of the sidebar that lists closed sessions.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est supprimé : les notes, les dépôts et les métadonnées Git sont conservés, et la session reste consultable dans Fermées. Elle ne pourra plus être rouverte avant d’être désarchivée."
          }
        }
      }
    },
    "Nothing is replaced unless you choose it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est remplacé sans votre accord."
          }
        }
      }
    },
    "Nothing to import: every template is already here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à importer : tous les modèles sont déjà là."
          }
        }
      }
    },
    "Nothing was restored or changed here. Quit that copy before working from this one.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a été restauré ni modifié ici. Quittez cette copie avant de travailler depuis celle-ci."
          }
        }
      }
