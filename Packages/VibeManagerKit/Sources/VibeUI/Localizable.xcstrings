          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アバターに、このバージョンで表示する表情（%@）が欠けています。生成されるまでデフォルトのアバターを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아바타에 이 버전에서 표시하는 표정(%@)이 없습니다. 생성될 때까지 기본 아바타가 표시됩니다."
