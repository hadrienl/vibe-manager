          }
        }
      }
    },
    "Terminated by signal %@": {
      "comment": "A session's state: its agent was killed by this signal number.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompue par le signal %@"
          }
        }
      }
    },
    "The agent could not be switched.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent n’a pas pu être changé."
          }
        }
      }
    },
    "The agent will ask you to sign in inside the terminal.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent vous demandera de vous connecter dans le terminal."
          }
        }
      }
    },
    "The agent will be stopped. The session can be restarted later.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent sera arrêté. La session pourra être relancée plus tard."
          }
        }
      }
    },
    "The background terminal host could not be used for it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’hôte des terminaux en arrière-plan n’a pas pu être utilisé pour lui."
          }
        }
      }
    },
    "The first match, or its first group when there is one.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première correspondance, ou son premier groupe s’il y en a un."
          }
        }
      }
    },
    "The notes are saved.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes sont enregistrées."
          }
