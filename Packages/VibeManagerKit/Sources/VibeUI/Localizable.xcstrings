          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent kodujący, który obsługuje sesje: jego narzędzia, prompty i uprawnienia. Brama tłumaczy między jego protokołem a protokołem endpointu."
          }
        },
        "pt-BR" : {
