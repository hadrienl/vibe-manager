    "%@ A new process will be started instead, and given this summary of what the session carries. You can edit it before it is sent." : {
      "comment" : "Why the conversation cannot be resumed, in one sentence.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ سيتم بدء عملية جديدة بدلًا من ذلك، مع هذا الملخص لمحتوى الجلسة. يمكنك تعديله قبل إرساله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Stattdessen wird ein neuer Prozess gestartet, der diese Zusammenfassung der Sitzung erhält. Du kannst sie vor dem Senden bearbeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ En su lugar se iniciará un nuevo proceso con este resumen de lo que contiene la sesión. Puedes editarlo antes de enviarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Un nouveau processus sera lancé à la place, avec ce résumé de ce que contient la session. Vous pouvez le modifier avant son envoi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ इसके बजाय एक नई प्रोसेस शुरू की जाएगी, और उसे सेशन की सामग्री का यह सारांश दिया जाएगा। भेजे जाने से पहले आप इसे संपादित कर सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Verrà invece avviato un nuovo processo, a cui verrà passato questo riepilogo di ciò che contiene la sessione. Puoi modificarlo prima dell’invio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@代わりに新しいプロセスが開始され、セッションの内容をまとめたこの要約が渡されます。送信する前に編集できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 대신 새로운 프로세스가 시작되며, 세션 내용을 담은 이 요약이 전달됩니다. 전송하기 전에 편집할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ In plaats daarvan wordt een nieuw proces gestart met deze samenvatting van wat de sessie bevat. Je kunt de samenvatting wijzigen voordat ze wordt verstuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Zamiast tego zostanie uruchomiony nowy proces, który otrzyma to podsumowanie zawartości sesji. Możesz je edytować przed wysłaniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Um novo processo será iniciado no lugar, com este resumo do conteúdo da sessão. Você pode editá-lo antes do envio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Вместо этого будет запущен новый процесс, которому передадут эту сводку содержимого сессии. Её можно изменить перед отправкой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Bunun yerine yeni bir işlem başlatılacak ve ona oturumun içeriğine dair bu özet verilecek. Göndermeden önce düzenleyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Натомість буде запущено новий процес, якому передадуть цей підсумок вмісту сеансу. Ви можете відредагувати його перед надсиланням."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 将改为启动新进程，并向其提供此会话内容摘要。你可以在发送前编辑它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 將改為啟動新的程序，並提供這份工作階段內容摘要。你可以在傳送前編輯。"
          }
        }
      }
    },
