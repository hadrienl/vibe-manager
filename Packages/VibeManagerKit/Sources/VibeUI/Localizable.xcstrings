                }
              }
            }
          }
        }
      }
    },
    "and %lld more, not listed" : {
      "localizations" : {
        "fr" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "et %lld autres, non listés"
                }
              },
