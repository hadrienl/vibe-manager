            "value": "Relance"
          }
        }
      }
    },
    "the default application": {
      "comment": "The application a file opens with, named inside a sentence: “could not be opened in …”.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "l’application par défaut"
          }
        }
      }
    },
    "usage.column.running": {
      "comment": "A column of the Usage window: running time. Not the state of a session.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps d’exécution"
          }
        }
      }
    },
    "{{name}} is a field, {{name?}} an optional one, {{name|/regex/}} keeps part of it. Write \\{{ to keep the braces as text.": {
      "comment": "Keep {{name}}, {{name?}}, {{name|/regex/}} and \\{{ as they are.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{{name}} est un champ, {{name?}} un champ facultatif, {{name|/regex/}} en garde une partie. Écrivez \\{{ pour garder les accolades comme du texte."
          }
        }
      }
    },
    "‹%@: no match›": {
      "comment": "In a prompt preview: a field whose pattern found nothing in its value.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "‹%@ : aucune correspondance›"
          }
        }
      }
    },
