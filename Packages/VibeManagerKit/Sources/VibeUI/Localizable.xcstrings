    "%@ Nothing was stopped or closed." : {
      "comment" : "Why the application could not reattach to its agents, in one sentence.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ لم يتم إيقاف أو إغلاق أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Nichts wurde gestoppt oder geschlossen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ No se ha detenido ni cerrado nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Rien n’a été arrêté ni fermé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ कुछ भी रोका या बंद नहीं किया गया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Nulla è stato arrestato o chiuso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@何も停止したり閉じたりしていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 아무것도 중단되거나 닫히지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Er is niets gestopt of gesloten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Niczego nie zatrzymano ani nie zamknięto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Nada foi parado ou fechado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ничего не было остановлено или закрыто."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Hiçbir şey durdurulmadı veya kapatılmadı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Нічого не зупинено й не закрито."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有停止或关闭任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未停止或關閉任何項目。"
          }
        }
      }
    },
    "%@ The file is left untouched, so nothing in it is lost." : {
      "comment" : "Why the notes could not be read, a sentence.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ تُرك الملف كما هو، لذا لم يُفقد أي شيء منه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Die Datei bleibt unverändert, sodass nichts verloren geht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ El archivo queda intacto, así que no se pierde nada de su contenido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Le fichier est laissé intact : rien de ce qu’il contient n’est perdu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ फ़ाइल को छुआ नहीं गया, इसलिए इसमें कुछ भी नहीं खोया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Il file non viene toccato, quindi nulla del suo contenuto va perso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ファイルはそのまま残されているため、内容は失われていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 파일은 그대로 유지되므로 내용이 손실되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Het bestand blijft ongemoeid, dus er gaat niets van verloren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Plik pozostaje nienaruszony, więc nic z niego nie zostanie utracone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ O arquivo é mantido intacto, então nada nele é perdido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Файл оставлен без изменений, поэтому ничего из него не потеряно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Dosyaya dokunulmadı; içindeki hiçbir şey kaybolmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Файл залишено без змін, тож нічого з нього не втрачено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 文件保持原样，其中的内容不会丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 檔案維持原樣，其中內容不會遺失。"
          }
        }
      }
    },
    "%@ This agent takes no initial prompt either, so the new process starts without any summary of the session." : {
      "comment" : "Why the conversation cannot be resumed, in one sentence.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ لا يقبل هذا الوكيل prompt أوليًا أيضًا، لذا تبدأ العملية الجديدة بدون أي ملخص للجلسة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Dieser Agent akzeptiert auch keinen anfänglichen Prompt, daher startet der neue Prozess ohne Zusammenfassung der Sitzung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Este agente tampoco acepta un prompt inicial, así que el nuevo proceso se inicia sin ningún resumen de la sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Cet agent n’accepte pas non plus de prompt initial : le nouveau processus démarre donc sans résumé de la session."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ यह एजेंट प्रारंभिक प्रॉम्प्ट भी स्वीकार नहीं करता, इसलिए नई प्रोसेस सेशन के किसी सारांश के बिना शुरू होती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Anche questo agente non accetta un prompt iniziale, quindi il nuovo processo si avvia senza alcun riepilogo della sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@このエージェントは最初のプロンプトも受け付けないため、新しいプロセスはセッションの要約なしで開始されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이 에이전트는 초기 프롬프트도 받지 않으므로 새로운 프로세스가 세션 요약 없이 시작됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Deze agent accepteert ook geen beginprompt, dus het nieuwe proces start zonder samenvatting van de sessie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ten agent nie przyjmuje też początkowego promptu, więc nowy proces uruchomi się bez podsumowania sesji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Este agente também não aceita prompt inicial, então o novo processo começa sem nenhum resumo da sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Этот агент также не принимает начальный промпт, поэтому новый процесс запустится без сводки сессии."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Bu ajan başlangıç istemi de almadığından yeni işlem oturumun herhangi bir özeti olmadan başlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Цей агент також не приймає початковий промпт, тому новий процес запуститься без підсумку сеансу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 此智能体也不接受初始提示词，因此新进程启动时不带任何会话摘要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 此代理程式也不接受初始提示詞，因此新的程序啟動時不會帶有工作階段摘要。"
          }
        }
      }
    },
