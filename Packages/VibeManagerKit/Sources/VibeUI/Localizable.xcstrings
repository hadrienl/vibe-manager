    "What recognises a ticket's address, and reads its title." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما يتعرّف على عنوان التذكرة، ويقرأ عنوانها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was die Adresse eines Tickets erkennt und seinen Titel liest."
          }
        },
        "es" : {
          "stringUnit" : {
