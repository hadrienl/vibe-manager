    "Type a ticket (#36, owner/repo#36), a pull or merge request URL, a branch, a folder or a title." : {
      "comment" : "The help of Open Quickly. Keep the examples as they are.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب تذكرة (#36، owner/repo#36)، أو URL لـ pull أو merge request، أو فرعًا، أو مجلدًا، أو عنوانًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib ein Ticket (#36, owner/repo#36), die URL eines Pull- oder Merge-Requests, einen Branch, einen Ordner oder einen Titel ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe un ticket (#36, owner/repo#36), la URL de una pull o merge request, una rama, una carpeta o un título."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapez un ticket (#36, owner/repo#36), l’URL d’une pull ou merge request, une branche, un dossier ou un titre."
