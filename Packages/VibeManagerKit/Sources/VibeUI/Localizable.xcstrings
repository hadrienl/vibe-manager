          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakończona sesja pokazuje swoje ostatnie wyjście i można ją uruchomić ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
