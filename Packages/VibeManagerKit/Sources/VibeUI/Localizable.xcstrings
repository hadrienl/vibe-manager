    "{{name}} is a field, {{name?}} an optional one, {{name|/regex/}} keeps part of it. Write \\{{ to keep the braces as text." : {
      "comment" : "Keep {{name}}, {{name?}}, {{name|/regex/}} and \\{{ as they are.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{name}} حقل، و{{name?}} حقل اختياري، و{{name|/regex/}} يحتفظ بجزء منه. اكتب \\{{ للاحتفاظ بالأقواس المعقوصة كنص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{name}} ist ein Feld, {{name?}} ein optionales, {{name|/regex/}} behält einen Teil davon. Schreibe \\{{, um die Klammern als Text zu behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{name}} es un campo, {{name?}} un campo opcional, {{name|/regex/}} conserva una parte. Escribe \\{{ para conservar las llaves como texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{name}} est un champ, {{name?}} un champ facultatif, {{name|/regex/}} en garde une partie. Écrivez \\{{ pour garder les accolades comme du texte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{name}} एक फ़ील्ड है, {{name?}} एक वैकल्पिक फ़ील्ड, {{name|/regex/}} उसका एक हिस्सा रखता है। कोष्ठकों को टेक्स्ट के रूप में रखने के लिए \\{{ लिखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{name}} è un campo, {{name?}} un campo facoltativo, {{name|/regex/}} ne conserva una parte. Scrivi \\{{ per mantenere le parentesi graffe come testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{name}}はフィールド、{{name?}}はオプションのフィールド、{{name|/regex/}}は値の一部を取り出します。波括弧をテキストとして残すには\\{{と書きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{name}}은 필드, {{name?}}은 선택적 필드이며, {{name|/regex/}}는 그 일부만 사용합니다. 중괄호를 텍스트로 유지하려면 \\{{를 입력하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{name}} is een veld, {{name?}} een optioneel veld, {{name|/regex/}} behoudt een deel ervan. Schrijf \\{{ om de accolades als tekst te behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{name}} to pole, {{name?}} pole opcjonalne, a {{name|/regex/}} zachowuje jego część. Wpisz \\{{, aby zachować nawiasy klamrowe jako tekst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{name}} é um campo, {{name?}} um campo opcional, {{name|/regex/}} mantém parte dele. Escreva \\{{ para manter as chaves como texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{name}} — поле, {{name?}} — необязательное поле, {{name|/regex/}} оставляет его часть. Напишите \\{{, чтобы оставить фигурные скобки текстом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{name}} bir alandır, {{name?}} isteğe bağlı bir alandır, {{name|/regex/}} alanın bir kısmını tutar. Süslü parantezleri metin olarak tutmak için \\{{ yazın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{name}} — це поле, {{name?}} — необов’язкове поле, {{name|/regex/}} залишає його частину. Напишіть \\{{, щоб залишити фігурні дужки як текст."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{name}} 是字段，{{name?}} 是可选字段，{{name|/regex/}} 保留其中一部分。输入 \\{{ 可将花括号保留为文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{name}} 是欄位，{{name?}} 是選填欄位，{{name|/regex/}} 會保留其中一部分。輸入 \\{{ 可將大括號保留為文字。"
          }
        }
      }
    },
