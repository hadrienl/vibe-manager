          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS защищает %@: при первом чтении этой папки агентом может появиться запрос разрешения."
          }
        },
        "tr" : {
          "stringUnit" : {
