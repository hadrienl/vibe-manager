    "Your avatar could not be read: the default one is shown. Make or import it again." : {
      "comment" : "The kept avatar cannot be read.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة صورتك الرمزية: يتم عرض الصورة الافتراضية. أنشئها أو استوردها مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Avatar konnte nicht gelesen werden: Der Standardavatar wird angezeigt. Erstelle oder importiere ihn erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido leer tu avatar: se muestra el avatar por omisión. Vuelve a crearlo o a importarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre avatar n’a pas pu être lu : l’avatar par défaut est montré. Recréez-le ou importez-le de nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका अवतार पढ़ा नहीं जा सका: डिफ़ॉल्ट अवतार दिखाया जा रहा है। इसे फिर से बनाएँ या इंपोर्ट करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere il tuo avatar: viene mostrato quello predefinito. Crealo o importalo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アバターを読み込めなかったため、デフォルトのアバターを表示しています。もう一度作成するか読み込んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아바타를 읽을 수 없어 기본 아바타를 표시합니다. 다시 만들거나 가져오십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je avatar kon niet worden gelezen: de standaardavatar wordt getoond. Maak of importeer hem opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można odczytać Twojego awatara: pokazywany jest domyślny. Utwórz go lub zaimportuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler seu avatar: o avatar padrão é mostrado. Crie-o ou importe-o novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать ваш аватар: показан аватар по умолчанию. Создайте или импортируйте его снова."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avatarınız okunamadı: varsayılan avatar gösteriliyor. Yeniden oluşturun veya içe aktarın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося прочитати ваш аватар: показано типовий. Створіть або імпортуйте його знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
