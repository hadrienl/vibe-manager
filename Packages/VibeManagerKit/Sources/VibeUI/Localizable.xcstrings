    "Usage is recorded on this Mac only. Nothing is sent anywhere." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُسجَّل الاستخدام على هذا الـ Mac فقط. لا يُرسل أي شيء إلى أي مكان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
