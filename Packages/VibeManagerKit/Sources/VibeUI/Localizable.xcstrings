          "stringUnit" : {
            "state" : "translated",
            "value" : "L’avatar n’a pas pu être renommé."
          }
        }
      }
    },
    "The avatar could not be written to disk. It is kept until then: save it again." : {
      "comment" : "Writing a generated avatar failed; it is kept in memory.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’avatar n’a pas pu être enregistré sur le disque. Il est gardé en attendant : réessayez l’enregistrement."
          }
        }
      }
    },
    "The avatar goes back to the bottom right corner of each screen." : {
      "localizations" : {
