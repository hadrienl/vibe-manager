          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ендпоінт не відповів вчасно. Можливо, локальна модель ще завантажується."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
