          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è stata archiviata, ma il suo processo (pid %2$@) non ha risposto all’arresto e potrebbe essere ancora in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
