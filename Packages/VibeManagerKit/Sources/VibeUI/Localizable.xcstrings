    "%@ cannot summarize this session: it is not signed in." : {
      "comment" : "An agent's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لـ %@ تلخيص هذه الجلسة: لم يتم تسجيل الدخول إليه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann diese Sitzung nicht zusammenfassen: Es ist nicht angemeldet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no puede resumir esta sesión: no tiene la sesión iniciada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas résumer cette session : il n’est pas connecté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ इस सेशन का सारांश नहीं बना सकता: यह साइन इन नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non può riassumere questa sessione: non ha eseguito l’accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はこのセッションを要約できません。サインインしていません。"
