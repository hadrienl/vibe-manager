        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 선택한 편집기가 더 이상 설치되어 있지 않습니다. 대신 Finder에서 파일을 표시했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
