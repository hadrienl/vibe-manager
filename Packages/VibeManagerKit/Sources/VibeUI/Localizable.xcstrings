    "Sessions already made keep their symbol and colour, even one no longer in these lists." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتفظ الجلسات الموجودة برمزها ولونها، حتى لو لم يعودا ضمن هذه القوائم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestehende Sitzungen behalten ihr Symbol und ihre Farbe, auch wenn diese nicht mehr in den Listen stehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones ya creadas conservan su símbolo y su color, aunque ya no figuren en estas listas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sessions existantes gardent leur symbole et leur couleur, même s’ils ne figurent plus dans ces listes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले से बने सेशन अपना प्रतीक और रंग बनाए रखते हैं, भले ही वह अब इन सूचियों में न हो।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sessioni già create mantengono il loro simbolo e colore, anche se non sono più in questi elenchi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作成済みのセッションは、これらの一覧から削除された記号や色であっても、そのまま保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 만든 세션은 이 목록에 더 이상 없는 기호와 색상이라도 그대로 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestaande sessies behouden hun symbool en kleur, ook als die niet meer in deze lijsten staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istniejące sesje zachowują swój symbol i kolor, nawet jeśli nie ma ich już na tych listach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sessões já criadas mantêm seu símbolo e sua cor, mesmo que não estejam mais nestas listas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже созданные сессии сохраняют свой символ и цвет, даже если их больше нет в этих списках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önceden oluşturulmuş oturumlar, artık bu listelerde olmasa bile simgelerini ve renklerini korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже створені сеанси зберігають свій символ і колір, навіть якщо їх більше немає в цих списках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已创建的会话会保留其符号和颜色，即使它们已不在这些列表中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已建立的工作階段會保留其符號和顏色，即使已不在這些列表中。"
          }
        }
      }
    },
    "Sessions archived from Done land here. Nothing is ever deleted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصل إلى هنا الجلسات المؤرشفة من «مكتملة». لا يُحذف أي شيء أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus „Erledigt“ archivierte Sitzungen landen hier. Es wird nie etwas gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones archivadas desde Terminada llegan aquí. Nunca se elimina nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sessions archivées depuis Terminé arrivent ici. Rien n’est jamais supprimé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“पूरा” से आर्काइव किए गए सेशन यहाँ आते हैं। कुछ भी कभी डिलीट नहीं होता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sessioni archiviate da Completato finiscono qui. Non viene mai eliminato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「完了」からアーカイブしたセッションはここに入ります。削除されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완료에서 보관한 세션이 여기에 표시됩니다. 아무것도 삭제되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessies die vanuit Klaar zijn gearchiveerd, komen hier terecht. Er wordt nooit iets verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj trafiają sesje zarchiwizowane z „Gotowe”. Nic nigdy nie jest usuwane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sessões arquivadas a partir de “Concluída” chegam aqui. Nada é apagado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сюда попадают сессии, архивированные из «Готово». Ничего никогда не удаляется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Tamamlandı” durumundan arşivlenen oturumlar buraya gelir. Hiçbir şey asla silinmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеанси, архівовані з «Виконано», потрапляють сюди. Нічого ніколи не видаляється."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从“已完成”归档的会话会出现在这里。不会删除任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從「已完成」封存的工作階段會出現在這裡。不會刪除任何內容。"
          }
        }
      }
    },
    "Sessions created from it keep their prompt." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتفظ الجلسات المنشأة منه بالـ prompt الخاص بها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daraus erstellte Sitzungen behalten ihren Prompt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones creadas con ella conservan su prompt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sessions créées à partir de lui gardent leur prompt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे बनाए गए सेशन अपना प्रॉम्प्ट बनाए रखते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sessioni create da questo template mantengono il loro prompt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このテンプレートから作成したセッションはプロンプトを保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 템플릿으로 생성한 세션은 프롬프트를 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessies die ermee zijn gemaakt, behouden hun prompt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesje utworzone z niego zachowują swój prompt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sessões criadas a partir dela mantêm o prompt."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Созданные из него сессии сохраняют свой промпт."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bundan oluşturulan oturumlar istemlerini korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеанси, створені з нього, зберігають свій промпт."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
