    "Not in this session's transcript: changed by a shell command, another session, or you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غير موجود في transcript هذه الجلسة: غيّره أمر shell أو جلسة أخرى أو أنت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht im Transkript dieser Sitzung: geändert durch einen Shell-Befehl, eine andere Sitzung oder dich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No está en el transcript de esta sesión: lo ha modificado un comando de shell, otra sesión o tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Absent du transcript de cette session : modifié par une commande shell, une autre session, ou vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस सेशन के ट्रांसक्रिप्ट में नहीं: शेल कमांड, किसी अन्य सेशन, या आपके द्वारा बदला गया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non presente nella trascrizione di questa sessione: modificato da un comando shell, da un’altra sessione o da te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセッションのトランスクリプトにはありません。シェルコマンド、別のセッション、またはあなたが変更しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
