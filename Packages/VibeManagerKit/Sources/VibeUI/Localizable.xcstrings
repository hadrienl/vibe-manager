    "The first match, or its first group when there is one." : {
      "comment" : "What a pattern takes out of a field's value.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أول مطابقة، أو مجموعتها الأولى إن وجدت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der erste Treffer oder seine erste Gruppe, falls vorhanden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera coincidencia, o su primer grupo si lo hay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première correspondance, ou son premier groupe s’il y en a un."
          }
