    "“%@” can’t be sent: its name contains a control character." : {
      "comment" : "The argument is a file name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذّر إرسال «%@»: يحتوي اسمه على حرف تحكم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann nicht übermittelt werden: Sein Name enthält ein Steuerzeichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede enviar “%@”: su nombre contiene un carácter de control."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » ne peut pas être transmis : son nom contient un caractère de contrôle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” भेजा नहीं जा सकता: इसके नाम में एक कंट्रोल वर्ण है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile inviare “%@”: il suo nome contiene un carattere di controllo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は送信できません。名前に制御文字が含まれています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”의 이름에 제어 문자가 있어 전송할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ kan niet worden verstuurd: de naam bevat een stuurteken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można przesłać „%@”: jego nazwa zawiera znak sterujący."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não pode ser enviado: o nome contém um caractere de controle."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невозможно передать «%@»: в имени есть управляющий символ."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” gönderilemiyor: adı bir denetim karakteri içeriyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» неможливо передати: його назва містить керівний символ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法发送“%@”：其名称包含控制字符。"
          }
        },
