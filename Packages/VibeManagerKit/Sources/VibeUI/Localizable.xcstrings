            "value" : "macOS beschermt %@: het kan om toestemming vragen wanneer de agent deze map voor het eerst leest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS chroni lokalizację %@: może poprosić o pozwolenie, gdy agent po raz pierwszy odczyta ten folder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
