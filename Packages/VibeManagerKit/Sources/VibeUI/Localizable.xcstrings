        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ भी योजना में नहीं। “करना है” में जोड़ा गया सेशन तब तक यहाँ प्रतीक्षा करता है जब तक आप उसे शुरू नहीं करते।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente in programma. Una sessione aggiunta a Da fare attende qui finché non la avvii."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予定はありません。「未着手」に追加したセッションは、開始するまでここで待機します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획된 항목이 없습니다. 할 일에 추가된 세션은 시작할 때까지 여기서 대기합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niets gepland. Een sessie die aan Te doen is toegevoegd, wacht hier totdat je haar start."
