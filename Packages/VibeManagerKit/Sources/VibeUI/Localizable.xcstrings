          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンドポイントが時間内に応答しませんでした。ローカルモデルがまだ読み込み中の可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "엔드포인트가 제시간에 응답하지 않았습니다. 로컬 모델을 아직 불러오는 중일 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
