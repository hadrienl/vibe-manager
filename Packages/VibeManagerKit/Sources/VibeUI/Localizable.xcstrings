      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ajouté"
          }
        }
      }
    },
    "and %lld more" : {
      "localizations" : {
        "fr" : {
          "variations" : {
            "plural" : {
