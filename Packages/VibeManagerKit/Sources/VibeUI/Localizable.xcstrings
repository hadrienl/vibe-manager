    "%@: %@": {
      "comment": "A session's name, then a sentence about it.\nA session's name, then what happened to it when the sessions were restored.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : %2$@"
          }
        }
      }
    },
    "%lld": {},
