    "The endpoint cannot be reached. Check the address, and that the server runs." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذّر الوصول إلى نقطة النهاية. تحقق من العنوان، ومن أن الخادم قيد التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Endpoint ist nicht erreichbar. Prüfe die Adresse und ob der Server läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede acceder al endpoint. Comprueba la dirección y que el servidor esté en marcha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’endpoint est injoignable. Vérifiez l’adresse, et que le serveur tourne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एंडपॉइंट तक नहीं पहुँचा जा सकता। पता जाँचें, और देखें कि सर्वर चल रहा है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere l’endpoint. Controlla l’indirizzo e che il server sia in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンドポイントに接続できません。アドレスと、サーバが動作していることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "엔드포인트에 연결할 수 없습니다. 주소와 서버 실행 여부를 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het endpoint is niet bereikbaar. Controleer het adres en of de server draait."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można połączyć się z endpointem. Sprawdź adres i czy serwer działa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível acessar o endpoint. Verifique o endereço e se o servidor está em execução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endpoint недоступен. Проверьте адрес и убедитесь, что сервер работает."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uç noktaya ulaşılamıyor. Adresi ve sunucunun çalıştığını denetleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ендпоінт недоступний. Перевірте адресу й те, що сервер працює."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
