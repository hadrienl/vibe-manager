    "It cannot be recovered. Export it first to keep it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن استرداده. صدّره أولًا للاحتفاظ به."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies kann nicht rückgängig gemacht werden. Exportiere es zuerst, um es zu behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se podrá recuperar. Expórtalo antes para conservarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne pourra pas être récupéré. Exportez-le d’abord pour le garder."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे वापस नहीं पाया जा सकता। इसे रखने के लिए पहले एक्सपोर्ट करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non potrà essere recuperato. Esportalo prima per conservarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復元することはできません。残しておくには先に書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복구할 수 없습니다. 보관하려면 먼저 내보내십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het kan niet worden hersteld. Exporteer het eerst om het te behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie będzie można go odzyskać. Najpierw go wyeksportuj, aby go zachować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não será possível recuperá-lo. Exporte-o antes para mantê-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его невозможно будет восстановить. Чтобы сохранить, сначала экспортируйте его."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri alınamaz. Saklamak için önce dışa aktarın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Його неможливо буде відновити. Спершу експортуйте його, щоб зберегти."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除后无法恢复。如需保留，请先导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除後無法復原。若要保留，請先輸出。"
          }
        }
      }
    },
    "Its look only: the agent draws the same character in ten expressions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مظهرها فقط: يرسم الوكيل الشخصية نفسها بعشرة تعبيرات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur sein Aussehen: Der Agent zeichnet dieselbe Figur in zehn Ausdrücken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo su aspecto: el agente dibuja el mismo personaje en diez expresiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son apparence seulement : l’agent dessine le même personnage dans dix expressions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल इसका रूप: एजेंट एक ही पात्र को दस भावों में बनाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo l’aspetto: l’agente disegna lo stesso personaggio in dieci espressioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外見のみを指定します。エージェントは同じキャラクターを10個の表情で描画します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모습만 설명하십시오. 에이전트가 같은 캐릭터를 10가지 표정으로 그립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen het uiterlijk: de agent tekent hetzelfde personage in tien expressies."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko wygląd: agent rysuje tę samą postać z dziesięcioma minami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas a aparência: o agente desenha o mesmo personagem em dez expressões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только внешность: агент рисует одного и того же персонажа в десяти выражениях."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca görünüşü: ajan aynı karakteri on ifadeyle çizer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лише зовнішність: агент малює того самого персонажа в десяти виразах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只需描述外观：智能体会用十个表情绘制同一个角色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只需描述外觀：代理程式會以十種表情繪製同一個角色。"
          }
        }
      }
    },
    "Its running agent will be stopped." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم إيقاف وكيلها قيد التشغيل."
          }
        },
