    "A process from that run may still be running (pid %@) and was left alone; check Activity Monitor." : {
      "comment" : "Process identifiers, separated by commas.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تكون عملية من ذلك التشغيل لا تزال قيد التشغيل (pid %@) وقد تُركت كما هي؛ تحقق في مراقب النشاط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Prozess dieses Durchlaufs läuft möglicherweise noch (PID %@) und wurde nicht angetastet; prüfe die Aktivitätsanzeige."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que un proceso de esa ejecución siga activo (pid %@) y no se ha tocado; compruébalo en el Monitor de Actividad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un processus de cette exécution tourne peut-être encore (pid %@) et n’a pas été touché ; vérifiez dans le Moniteur d’activité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उस रन की एक प्रोसेस शायद अभी भी चल रही है (pid %@) और उसे छुआ नहीं गया; गतिविधि मॉनिटर में जाँचें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un processo di quell’esecuzione potrebbe essere ancora attivo (pid %@) ed è stato lasciato com’è; controlla Monitoraggio Attività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その実行のプロセスがまだ実行中の可能性があり（pid %@）、そのままにしてあります。アクティビティモニタで確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 실행의 프로세스가 아직 실행 중일 수 있으며(pid %@) 그대로 두었습니다. 활성 상태 보기에서 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een proces van die uitvoering draait mogelijk nog (pid %@) en is ongemoeid gelaten; controleer Activiteitenweergave."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proces z tamtego uruchomienia może nadal działać (pid %@) i nie został ruszony; sprawdź w Monitorze aktywności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um processo dessa execução pode ainda estar em execução (pid %@) e não foi tocado; verifique no Monitor de Atividade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Процесс того запуска, возможно, ещё работает (pid %@) и не был затронут; проверьте Мониторинг системы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O çalıştırmadan kalan bir işlem hâlâ çalışıyor olabilir (pid %@) ve ona dokunulmadı; Etkinlik Monitörü’ne bakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Процес із того запуску, можливо, досі працює (pid %@), його не зачеплено; перевірте Моніторинг системи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该次运行的某个进程可能仍在运行（pid %@），且未被处理；请在“活动监视器”中检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該次執行的程序可能仍在執行（pid %@），未被處理；請查看「活動監視器」。"
          }
        }
      }
    },
