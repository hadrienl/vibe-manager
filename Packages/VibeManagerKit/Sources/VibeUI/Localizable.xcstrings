          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此工作階段中有多個請求在等待：請在工作階段中回應。"
          }
        }
      }
    },
    "Shared by every session, apart from Safari." : {
