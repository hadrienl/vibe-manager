    "%@ is not a field — names use letters, digits, - and _ — so it stays as text." : {
      "comment" : "What the user wrote between double braces.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ليس حقلًا — تتكون الأسماء من أحرف وأرقام و- و_ — لذا يبقى نصًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist kein Feld – Namen bestehen aus Buchstaben, Ziffern, - und _ – und bleibt daher Text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no es un campo — los nombres usan letras, cifras, - y _ —, así que se queda como texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas un champ — un nom utilise des lettres, des chiffres, - et _ — et reste donc du texte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ फ़ील्ड नहीं है — नामों में अक्षर, अंक, - और _ होते हैं — इसलिए यह टेक्स्ट ही रहता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è un campo — i nomi usano lettere, cifre, - e _ — quindi resta testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はフィールドではないため、テキストのまま残ります（名前に使えるのは英字、数字、-、_です）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 필드가 아니므로(이름에는 문자, 숫자, - 및 _만 사용) 텍스트로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is geen veld — namen bestaan uit letters, cijfers, - en _ — dus het blijft tekst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie jest polem — nazwy składają się z liter, cyfr, - i _ — więc pozostaje tekstem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não é um campo — os nomes usam letras, dígitos, - e _ — então permanece como texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — не поле (в названиях допустимы буквы, цифры, - и _), поэтому остаётся текстом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bir alan değil — adlarda harf, rakam, - ve _ kullanılır — bu nedenle metin olarak kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не є полем — назви складаються з літер, цифр, - і _ — тому залишається текстом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是字段（名称只能使用字母、数字、- 和 _），因此保留为文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是欄位 — 名稱只能使用字母、數字、- 和 _ — 因此保留為文字。"
          }
        }
      }
    },
