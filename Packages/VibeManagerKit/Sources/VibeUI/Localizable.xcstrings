                "stringUnit" : {
                  "state" : "translated",
                  "value" : "et %lld autres, non listés"
                }
              }
            }
          }
        }
      }
    },
    "branch %@" : {
      "comment" : "Said by VoiceOver on a request's card.\nWhat VoiceOver says of a repository's branch: its name.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "branche %@"
          }
        }
      }
    },
