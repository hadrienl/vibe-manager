    "Nothing done yet. Swipe a session to move it here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد شيء مكتمل بعد. اسحب جلسة لنقلها إلى هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts erledigt. Streiche über eine Sitzung, um sie hierher zu verschieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay nada terminado. Desliza una sesión para moverla aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien de terminé pour l’instant. Balayez une session pour la déplacer ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी तक कुछ पूरा नहीं हुआ। किसी सेशन को यहाँ ले जाने के लिए स्वाइप करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora niente di completato. Scorri una sessione per spostarla qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完了したものはまだありません。セッションをスワイプするとここに移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 완료된 항목이 없습니다. 세션을 쓸어넘겨 여기로 이동하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog niets klaar. Veeg over een sessie om haar hierheen te verplaatsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic jeszcze nie jest gotowe. Przesuń sesję, aby ją tu przenieść."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada concluído ainda. Deslize uma sessão para movê-la para cá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока ничего не готово. Смахните сессию, чтобы переместить её сюда."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz tamamlanan bir şey yok. Buraya taşımak için bir oturumu kaydırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ще нічого не виконано. Проведіть по сеансу, щоб перемістити його сюди."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚无已完成的会话。轻扫会话即可将其移到这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚無已完成項目。滑動工作階段即可移至此處。"
          }
        }
      }
    },
