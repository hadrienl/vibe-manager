    "Of the terminal, the conversation, the activity and the notes. ⌥-click opens the other way." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للطرفية والمحادثة والنشاط والملاحظات. النقر مع ⌥ يفتح بالطريقة الأخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Terminal, Unterhaltung, Aktivität und Notizen. ⌥-Klick öffnet auf die andere Art."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del terminal, la conversación, la actividad y las notas. ⌥-clic abre de la otra forma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du terminal, de la conversation, de l’activité et des notes. ⌥-clic ouvre de l’autre façon."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टर्मिनल, बातचीत, गतिविधि और नोट्स का। ⌥-क्लिक दूसरे तरीके से खोलता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del terminale, della conversazione, dell’attività e delle note. Opzione-clic apre nell’altro modo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナル、会話、アクティビティ、メモに適用されます。⌥クリックでもう一方の方法で開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널, 대화, 활동 및 메모에 적용됩니다. ⌥-클릭하면 다른 방식으로 엽니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Van de terminal, het gesprek, de activiteit en de notities. ⌥-klik opent op de andere manier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminala, rozmowy, aktywności i notatek. Kliknięcie z ⌥ otwiera w drugi sposób."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do terminal, da conversa, da atividade e das notas. ⌥-clique abre do outro jeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Терминала, беседы, активности и заметок. Нажатие с ⌥ открывает другим способом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal, konuşma, etkinlik ve notlar için. ⌥ ile tıklamak diğer şekilde açar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Термінала, розмови, активності й нотаток. Клацання з ⌥ відкриває навпаки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于终端、对话、活动和备注。按住 ⌥ 键点按则以另一种方式打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終端機、對話、活動和筆記。按住 ⌥ 並按一下會以另一種方式打開。"
          }
        }
      }
    },
    "Offered when a session or a template is given its appearance. Drag to reorder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُعرض عند تحديد مظهر جلسة أو قالب. اسحب لإعادة الترتيب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angeboten, wenn das Erscheinungsbild einer Sitzung oder Vorlage festgelegt wird. Zum Neuanordnen ziehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ofrecen al dar aspecto a una sesión o a una plantilla. Arrastra para reordenar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proposés pour l’apparence d’une session ou d’un gabarit. Faites glisser pour réordonner."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेशन या टेम्पलेट का रूप तय करते समय उपलब्ध। क्रम बदलने के लिए ड्रैग करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proposti quando si assegna l’aspetto a una sessione o a un template. Trascina per riordinare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションやテンプレートの外観を設定するときに表示されます。ドラッグして並べ替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션이나 템플릿의 모양을 지정할 때 제공됩니다. 드래그하여 순서를 변경하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aangeboden bij het kiezen van het uiterlijk van een sessie of sjabloon. Sleep om te herschikken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proponowane przy wyborze wyglądu sesji lub szablonu. Przeciągnij, aby zmienić kolejność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oferecidos ao definir a aparência de uma sessão ou predefinição. Arraste para reordenar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предлагаются при выборе оформления сессии или шаблона. Перетащите, чтобы изменить порядок."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir oturuma veya şablona görünüm verilirken sunulur. Yeniden sıralamak için sürükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропонуються під час вибору вигляду сеансу або шаблону. Перетягніть, щоб змінити порядок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为会话或模板设置外观时提供。拖移以重新排序。"
