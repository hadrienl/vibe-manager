    "Moving it to %@ starts its agent again." : {
      "comment" : "A task status.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقلها إلى «%@» يعيد تشغيل وكيلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Verschieben nach „%@“ startet ihr Agent neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al pasarla a “%@”, se vuelve a iniciar su agente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La passer à « %@ » relance son agent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे “%@” में ले जाने से इसका एजेंट फिर से शुरू होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spostarla in “%@” riavvia il suo agente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」に移動すると、エージェントが再起動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”(으)로 이동하면 에이전트가 다시 시작됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je haar naar ‘%@’ verplaatst, start de agent opnieuw."
          }
        },
        "pl" : {
