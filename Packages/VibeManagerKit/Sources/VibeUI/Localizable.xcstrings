          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終了したセッションには最後の出力が表示され、再起動できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "종료된 세션은 마지막 출력을 표시하며 재시작할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
