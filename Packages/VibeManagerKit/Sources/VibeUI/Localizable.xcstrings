          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twojemu awatarowi brakuje min, które pokazuje ta wersja (%@): do czasu ich wygenerowania pokazywany jest domyślny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faltam ao seu avatar expressões que esta versão mostra (%@): o avatar padrão é mostrado até que elas sejam geradas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашему аватару не хватает выражений, которые показывает эта версия (%@): до их создания показывается аватар по умолчанию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avatarınızda bu sürümün gösterdiği bazı ifadeler eksik (%@): bunlar oluşturulana kadar varsayılan avatar gösterilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашому аватару бракує виразів, які показує ця версія (%@): доки їх не згенеровано, показується типовий."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的头像缺少此版本显示的表情（%@）：在生成这些表情之前将显示默认头像。"
