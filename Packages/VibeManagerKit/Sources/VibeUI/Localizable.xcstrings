    "The download failed. Check the connection and try again." : {
      "comment" : "Under a speech model whose download failed.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل التنزيل. تحقق من الاتصال وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Laden ist fehlgeschlagen. Prüfe die Verbindung und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La descarga ha fallado. Comprueba la conexión e inténtalo de nuevo."
