          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連線至端點。請檢查位址，並確認伺服器正在執行。"
          }
        }
      }
    },
    "The endpoint did not answer in time. A local model may still be loading." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تستجب نقطة النهاية في الوقت المحدد. قد يكون نموذج محلي لا يزال قيد التحميل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Endpoint hat nicht rechtzeitig geantwortet. Ein lokales Modell lädt möglicherweise noch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El endpoint no ha respondido a tiempo. Puede que un modelo local aún se esté cargando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’endpoint n’a pas répondu à temps. Un modèle local est peut-être encore en chargement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एंडपॉइंट ने समय पर उत्तर नहीं दिया। शायद कोई लोकल मॉडल अभी भी लोड हो रहा है।"
          }
        },
        "it" : {
          "stringUnit" : {
