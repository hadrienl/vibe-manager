          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 要求登录：请在某个会话的网页视图中登录，然后重新测试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
