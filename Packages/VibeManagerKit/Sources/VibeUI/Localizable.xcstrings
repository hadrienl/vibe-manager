          }
        }
      }
    },
    "Your avatar lacks expressions this version shows (%@): the default one is shown until they are generated." : {
      "comment" : "The kept avatar is incomplete.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنقص صورتك الرمزية تعبيرات يعرضها هذا الإصدار (%@): يتم عرض الصورة الافتراضية إلى أن يتم إنشاؤها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deinem Avatar fehlen Ausdrücke, die diese Version zeigt (%@): Bis sie generiert sind, wird der Standardavatar angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tu avatar le faltan expresiones que muestra esta versión (%@): se muestra el avatar por omisión hasta que se generen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il manque à votre avatar des expressions qu’affiche cette version (%@) : l’avatar par défaut est montré jusqu’à ce qu’elles soient générées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके अवतार में वे भाव नहीं हैं जो यह संस्करण दिखाता है (%@): उनके जनरेट होने तक डिफ़ॉल्ट अवतार दिखाया जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
