    "Decisions, links, what to check next — saved automatically." : {
      "comment" : "The placeholder of empty notes.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القرارات والروابط وما يجب التحقق منه لاحقًا — تُحفظ تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entscheidungen, Links, nächste Prüfpunkte – automatisch gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decisiones, enlaces, qué comprobar después — se guarda automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décisions, liens, ce qu’il faut vérifier ensuite — enregistré automatiquement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निर्णय, लिंक, आगे क्या जाँचना है — अपने आप सहेजा जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decisioni, link, cosa verificare dopo — salvato automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "決定事項、リンク、次に確認すること — 自動的に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결정 사항, 링크, 다음에 확인할 내용 — 자동으로 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beslissingen, links, wat je hierna moet controleren — automatisch bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decyzje, łącza, co sprawdzić dalej — zachowywane automatycznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decisões, links, o que verificar em seguida — salvo automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Решения, ссылки, что проверить дальше — сохраняется автоматически."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kararlar, bağlantılar, sırada kontrol edilecekler — otomatik olarak kaydedilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рішення, посилання, що перевірити далі — зберігається автоматично."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
