    "Terminal — %@ — %@": {
      "comment": "What VoiceOver calls a terminal: the session's name, then its state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Terminal — %1$@ — %2$@"
