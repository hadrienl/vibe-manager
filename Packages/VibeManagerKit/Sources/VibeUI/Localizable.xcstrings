    "Add a model that can call tools: read them from the endpoint, or type one." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف نموذجًا قادرًا على استدعاء الأدوات: اقرأ النماذج من نقطة النهاية، أو اكتب واحدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ein Modell hinzu, das Tools aufrufen kann: Lies sie vom Endpoint ein oder gib eines ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un modelo que pueda llamar a herramientas: léelos desde el endpoint o escribe uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un modèle qui sait appeler des outils : lisez-les depuis l’endpoint, ou saisissez-en un."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐसा मॉडल जोड़ें जो टूल कॉल कर सके: उन्हें एंडपॉइंट से पढ़ें, या एक टाइप करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
