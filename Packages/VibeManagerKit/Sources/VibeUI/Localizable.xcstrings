    "This agent will stop when Vibe Manager quits.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet agent s’arrêtera quand vous quitterez Vibe Manager."
          }
        }
      }
    },
    "This editor is no longer installed: files are revealed in the Finder instead.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet éditeur n’est plus installé : les fichiers sont affichés dans le Finder à la place."
          }
        }
      }
    },
    "This session": {
      "comment": "Stands for the name of a session that is no longer listed.",
