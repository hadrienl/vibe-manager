    "Worth trying when the previous model is what the agent refused, rather than the conversation itself." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستحق التجربة عندما يكون الوكيل قد رفض النموذج السابق، وليس المحادثة نفسها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Versuch wert, wenn der Agent eher das vorherige Modell abgelehnt hat als die Unterhaltung selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Útil cuando lo que el agente rechazó fue el modelo anterior y no la conversación en sí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utile quand l’agent a refusé le modèle précédent, plutôt que la conversation elle-même."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तब आज़माने लायक जब एजेंट ने बातचीत के बजाय पिछले मॉडल को अस्वीकार किया हो।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale la pena provare quando l’agente ha rifiutato il modello precedente, piuttosto che la conversazione stessa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントが会話そのものではなく、以前のモデルを拒否した場合に試す価値があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 대화 자체가 아니라 이전 모델을 거부한 경우 시도해 볼 만합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het proberen waard wanneer de agent het vorige model weigerde, en niet het gesprek zelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warto spróbować, gdy agent odrzucił poprzedni model, a nie samą rozmowę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale a pena tentar quando o agente recusou o modelo anterior, e não a conversa em si."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стоит попробовать, если агент отказался от предыдущей модели, а не от самой беседы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajanın reddettiği şey konuşmanın kendisi değil de önceki model olduğunda denemeye değer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Варто спробувати, коли агент відхилив попередню модель, а не саму розмову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当智能体拒绝的是之前的模型而非对话本身时，值得一试。"
