    "Nothing planned. A session added to To Do waits here until you start it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد شيء مخطط. الجلسة المضافة إلى «للتنفيذ» تنتظر هنا حتى تبدأها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts geplant. Eine zu „Zu erledigen“ hinzugefügte Sitzung wartet hier, bis du sie startest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
