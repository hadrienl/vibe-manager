        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 로그인되어 있지 않아 이 세션을 요약할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan deze sessie niet samenvatten: je bent niet ingelogd."
