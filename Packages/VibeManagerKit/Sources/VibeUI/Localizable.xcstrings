    "⌃⌥⌘P answers the requests from any application." : {
      "comment" : "VoiceOver's hint on the palette of requests: its global shortcut.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح ⌃⌥⌘P الرد على الطلبات من أي تطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit ⌃⌥⌘P beantwortest du die Anfragen aus jeder App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌃⌥⌘P permite responder a las solicitudes desde cualquier app."
