          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ просит войти: войдите в веб-панели сессии, затем проверьте снова."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ giriş yapmanızı istiyor: bir oturumun web görünümünde giriş yapın, sonra yeniden test edin."
          }
        },
        "uk" : {
          "stringUnit" : {
