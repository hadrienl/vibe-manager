    "Nothing is done unless you allow it; the request expires %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتم فعل أي شيء دون إذنك؛ تنتهي صلاحية الطلب %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne deine Erlaubnis geschieht nichts; die Anfrage läuft %@ ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se hace nada sin tu permiso; la solicitud caduca %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’est fait sans votre accord ; la demande expire %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी अनुमति के बिना कुछ नहीं किया जाता; अनुरोध %@ समाप्त हो जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non viene fatto nulla senza la tua autorizzazione; la richiesta scade %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可しない限り何も実行されません。リクエストの有効期限：%@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "허용하지 않으면 아무것도 수행되지 않습니다. 요청은 %@ 만료됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er gebeurt niets tenzij je het toestaat; het verzoek verloopt %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic nie zostanie zrobione bez Twojej zgody; prośba wygasa %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada é feito sem sua permissão; a solicitação expira %@."
          }
        },
        "ru" : {
