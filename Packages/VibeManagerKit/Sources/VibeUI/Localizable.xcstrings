    "Worth trying when the previous model is what the agent refused, rather than the conversation itself." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utile quand l’agent a refusé le modèle précédent, plutôt que la conversation elle-même."
          }
        }
      }
    },
    "Write the identifier shown before the title." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrivez l’identifiant affiché devant le titre."
          }
        }
      }
    },
    "Write the pattern of the addresses it recognises." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrivez le motif des adresses qu’il reconnaît."
          }
        }
      }
    },
    "You appear to be offline." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous semblez hors ligne."
          }
        }
      }
    },
    "You can change this later in Settings." : {
      "comment" : "Under the question about an agent's hooks.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pourrez changer d’avis plus tard dans les Réglages."
          }
        }
      }
    },
    "You can skip this. Agents still run, and macOS only asks when one of them reaches a protected folder. You can come back to it in Settings at any time." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez passer cette étape. Les agents fonctionnent quand même, et macOS ne demande que lorsque l’un d’eux accède à un dossier protégé. Vous pourrez y revenir à tout moment dans les Réglages."
          }
        }
      }
    },
    "You will be signed out of every site in every session’s web view." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous serez déconnecté de tous les sites dans la vue web de chaque session."
          }
        }
      }
    },
    "Your additions and your order are lost." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos ajouts et votre ordre seront perdus."
          }
        }
      }
    },
    "Your agents are still running in the background, but Vibe Manager could not reattach." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos agents s’exécutent toujours en arrière-plan, mais Vibe Manager n’a pas pu s’y reconnecter."
          }
        }
      }
    },
    "Your agents are still running in the background, but Vibe Manager could not reattach. %@" : {
      "comment" : "Why the application could not reattach to its agents, in one sentence.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos agents s’exécutent toujours en arrière-plan, mais Vibe Manager n’a pas pu s’y reconnecter. %@"
          }
        }
      }
    },
    "Your answer" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre réponse"
          }
        }
      }
    },
    "Your avatar could not be read: the default one is shown. Make or import it again." : {
      "comment" : "The kept avatar cannot be read.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre avatar n’a pas pu être lu : l’avatar par défaut est montré. Recréez-le ou importez-le de nouveau."
          }
        }
      }
    },
    "Your avatar lacks expressions this version shows (%@): the default one is shown until they are generated." : {
      "comment" : "The kept avatar is incomplete.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il manque à votre avatar des expressions qu’affiche cette version (%@) : l’avatar par défaut est montré jusqu’à ce qu’elles soient générées."
          }
        }
      }
    },
    "Your changes are lost if you don't save them." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos modifications seront perdues si vous ne les enregistrez pas."
          }
        }
      }
    },
    "a session" : {
      "comment" : "Stands for a session whose name is unknown.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "une session"
          }
        }
      }
    },
    "access to %@" : {
      "comment" : "What always allowing grants: access to these folders.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "l’accès à %@"
          }
        }
      }
    },
    "added" : {
