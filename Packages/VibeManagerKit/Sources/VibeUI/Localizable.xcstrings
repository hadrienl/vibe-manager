    "Proposed by the template — change it if needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقترحه القالب — غيّره إذا لزم الأمر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von der Vorlage vorgeschlagen – ändere es bei Bedarf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propuesto por la plantilla — cámbialo si hace falta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proposé par le gabarit — modifiez-le si besoin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टेम्पलेट द्वारा सुझाया गया — ज़रूरत हो तो इसे बदलें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proposto dal template — modificalo se serve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テンプレートによる提案です — 必要なら変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "템플릿에서 제안됨 — 필요하면 변경하십시오."
          }
        },
        "nl" : {
