    "Compared with %@, as last fetched: nothing is fetched here." : {
      "comment" : "The upstream branch: origin/main.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بالمقارنة مع %@، كما جُلب آخر مرة: لا يتم جلب أي شيء هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verglichen mit %@ vom letzten Fetch: Hier wird nichts abgerufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparado con %@ tal como se obtuvo la última vez: aquí no se obtiene nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparé à %@, tel que récupéré la dernière fois : rien n’est récupéré ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ से तुलना, पिछली बार fetch किए अनुसार: यहाँ कुछ भी fetch नहीं किया जाता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confrontato con %@, come all’ultimo fetch: qui non viene eseguito alcun fetch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後にフェッチした%@と比較しています。ここではフェッチしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막으로 가져온 %@와(과) 비교함: 여기서는 아무것도 가져오지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergeleken met %@, zoals laatst opgehaald: hier wordt niets opgehaald."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porównano z %@ według ostatniego pobrania: tutaj nic nie jest pobierane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparado com %@, como no último fetch: nenhum fetch é feito aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сравнение с %@ на момент последнего fetch: здесь ничего не загружается."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En son alındığı hâliyle %@ ile karşılaştırıldı: burada hiçbir şey alınmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порівняно з %@ на момент останнього fetch: тут нічого не завантажується."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与上次获取的 %@ 比较：此处不会执行获取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與上次 fetch 時的 %@ 比較：此處不會 fetch。"
          }
        }
      }
    },
