        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Schlüsselbund gespeichert, nie wieder angezeigt. Gib einen neuen ein, um ihn zu ersetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda en el llavero y no se vuelve a mostrar. Escribe una nueva para sustituirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardée dans le trousseau, jamais réaffichée. Saisissez-en une nouvelle pour la remplacer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कीचेन में रखी गई, फिर कभी नहीं दिखाई जाएगी। इसे बदलने के लिए नई टाइप करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservata nel portachiavi, non viene più mostrata. Digitane una nuova per sostituirla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーチェーンに保管され、再表示されることはありません。置き換えるには新しいキーを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키체인에 보관되며 다시 표시되지 않습니다. 대체하려면 새로 입력하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaard in de sleutelhanger, nooit meer getoond. Typ een nieuwe om hem te vervangen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przechowywany w pęku kluczy, nigdy więcej nie wyświetlany. Wpisz nowy, aby go zastąpić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardada no chaveiro, nunca mais exibida. Digite uma nova para substituí-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранится в связке ключей и больше не показывается. Введите новый, чтобы заменить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anahtar zincirinde saklanır, bir daha gösterilmez. Değiştirmek için yenisini yazın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігається у в’язці ключів і більше не показується. Введіть новий, щоб замінити його."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存在钥匙串中，不会再显示。输入新的值即可替换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存在鑰匙圈中，不會再顯示。輸入新的即可取代。"
          }
        }
      }
    },
