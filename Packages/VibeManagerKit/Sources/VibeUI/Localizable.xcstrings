      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "les modifications de ces fichiers"
          }
        }
      }
    },
    "checked %lld s ago" : {
      "comment" : "When the Git list was last checked against the disk: a number of seconds.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "vérifié il y a %lld s"
          }
