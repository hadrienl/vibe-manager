        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기호는 흰색으로 그려지므로, 그 위에서 기호를 읽을 수 있는 색상만 허용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
