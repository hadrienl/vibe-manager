            "value" : "İstem olmadan ajan yapacak bir şey olmadan başlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без промпту агент запускається без завдання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
