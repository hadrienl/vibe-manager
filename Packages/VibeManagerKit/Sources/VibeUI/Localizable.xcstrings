          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "負責辨識工單位址並讀取其標題的項目。"
          }
        }
      }
    },
    "What runs in its side terminals will be stopped: %@." : {
      "comment" : "The argument lists the commands running in the session's side terminals.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم إيقاف ما يعمل في طرفياتها الجانبية: %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was in ihren Nebenterminals läuft, wird gestoppt: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detendrá lo que se ejecuta en sus terminales laterales: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui tourne dans ses terminaux annexes sera arrêté : %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके साइड टर्मिनल में जो चल रहा है वह रोक दिया जाएगा: %@।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che è in esecuzione nei suoi terminali laterali verrà arrestato: %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイドターミナルで実行中の処理は停止されます：%@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보조 터미널에서 실행 중인 항목이 중단됩니다: %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat in de zijterminals draait, wordt gestopt: %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co działa w jej terminalach bocznych, zostanie zatrzymane: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que está em execução nos terminais laterais dela será parado: %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё, что работает в её боковых терминалах, будет остановлено: %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yan terminallerinde çalışanlar durdurulacak: %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Те, що працює в його бічних терміналах, буде зупинено: %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其侧边终端中运行的内容将被停止：%@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其側邊終端機中執行的內容將會停止：%@。"
          }
        }
      }
    },
