    "Follows Settings › Conversation, in light and dark mode." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتبع الإعدادات › المحادثة، في الوضعين الفاتح والداكن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folgt Einstellungen › Unterhaltung, im hellen wie im dunklen Modus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue Ajustes › Conversación, tanto en el modo claro como en el oscuro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suit Réglages › Conversation, en mode clair comme en mode sombre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइट और डार्क दोनों मोड में, सेटिंग्ज़ › बातचीत के अनुसार चलता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segue Impostazioni › Conversazione, in modalità chiara e scura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライトモードでもダークモードでも、「設定」›「会話」に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이트 및 다크 모드 모두 설정 › 대화를 따릅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volgt Instellingen › Gesprek, in lichte en donkere modus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgodnie z Ustawienia › Rozmowa, w trybie jasnym i ciemnym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segue Ajustes › Conversa, nos modos claro e escuro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следует «Настройки» › «Беседа» в светлом и тёмном режимах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açık ve koyu modda Ayarlar › Konuşma’yı izler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відповідно до «Параметри › Розмова» у світлому й темному режимах."
          }
        },
        "zh-Hans" : {
