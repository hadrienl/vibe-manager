          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер разработки часто подписывает собственный сертификат. Продолжайте, только если это ваш сервер."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geliştirme sunucuları çoğu zaman kendi sertifikalarını imzalar. Yalnızca sunucu sizinse devam edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер розробки часто сам підписує свій сертифікат. Продовжуйте, лише якщо він ваш."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开发服务器通常会自签证书。仅当它是你自己的服务器时才继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
