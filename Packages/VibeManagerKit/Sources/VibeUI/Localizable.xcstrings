    "Several requests are waiting in this session: answer in the session." : {
      "comment" : "Why a request is answered in its terminal: which of them is on screen is not known.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توجد عدة طلبات تنتظر في هذه الجلسة: أجب في الجلسة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Sitzung warten mehrere Anfragen: Antworte in der Sitzung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay varias solicitudes pendientes en esta sesión: responde en la sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs demandes attendent dans cette session : répondez dans la session."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस सेशन में कई अनुरोध प्रतीक्षा में हैं: सेशन में उत्तर दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diverse richieste sono in attesa in questa sessione: rispondi nella sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセッションでは複数のリクエストが待機中です。セッション内で回答してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 세션에서 여러 요청이 대기 중입니다. 세션에서 답하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wachten meerdere verzoeken in deze sessie: antwoord in de sessie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tej sesji czeka kilka próśb: odpowiedz w sesji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Várias solicitações estão pendentes nesta sessão: responda na sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этой сессии ожидает несколько запросов: ответьте в сессии."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu oturumda birkaç istek bekliyor: oturumda yanıtlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У цьому сеансі очікує кілька запитів: дайте відповідь у сеансі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
