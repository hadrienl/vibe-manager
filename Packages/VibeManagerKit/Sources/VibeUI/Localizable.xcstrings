    "Running sessions keep what they started with until they are restarted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتفظ الجلسات قيد التشغيل بإعداداتها إلى أن تُعاد تشغيلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laufende Sitzungen behalten ihre Startkonfiguration bis zum Neustart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones en ejecución conservan su configuración hasta que se reinician."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sessions en cours gardent leur configuration jusqu’à leur relance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चल रहे सेशन फिर से शुरू होने तक अपनी शुरुआती कॉन्फ़िगरेशन बनाए रखते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sessioni in esecuzione mantengono la configurazione con cui sono partite finché non vengono riavviate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行中のセッションは、再起動するまで開始時の設定を保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행 중인 세션은 재시작할 때까지 시작 시의 구성을 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actieve sessies behouden hun instellingen totdat ze worden herstart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Działające sesje zachowują początkowe ustawienia do czasu ponownego uruchomienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sessões em execução mantêm a configuração inicial até serem reiniciadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работающие сессии сохраняют исходные настройки до перезапуска."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalışan oturumlar, yeniden başlatılana kadar başladıkları ayarları korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запущені сеанси зберігають початкові налаштування до перезапуску."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在运行的会话会保留启动时的设置，直到重新启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "執行中的工作階段會保留啟動時的設定，直到重新啟動為止。"
          }
        }
      }
    },
