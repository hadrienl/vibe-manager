    "Version" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version"
          }
        }
      }
    },
    "Version %@ is available." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version %@ est disponible."
          }
        }
      }
    },
    "Version %@ will be installed when you quit Vibe Manager." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version %@ sera installée quand vous quitterez Vibe Manager."
          }
        }
      }
    },
    "Vibe Manager" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe Manager"
          }
        }
      }
    },
    "Vibe Manager runs coding agents on your behalf. macOS asks for permission every time one of them reads your Desktop, Documents, Downloads, an external disk or iCloud Drive — and it asks in the name of this application, once per folder." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibe Manager exécute des agents de code en votre nom. macOS demande une autorisation chaque fois que l’un d’eux lit votre Bureau, vos Documents, vos Téléchargements, un disque externe ou iCloud Drive — et il la demande au nom de cette application, une fois par dossier."
          }
        }
      }
    },
    "Vibe Manager stopped unexpectedly. %lld sessions were running." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Vibe Manager stopped unexpectedly. %lld session was running."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Vibe Manager stopped unexpectedly. %lld sessions were running."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Vibe Manager s’est arrêté de façon inattendue. %lld sessions étaient en cours."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Vibe Manager s’est arrêté de façon inattendue. %lld session était en cours."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Vibe Manager s’est arrêté de façon inattendue. %lld sessions étaient en cours."
                }
              }
            }
          }
        }
      }
    },
    "Vision" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vision"
          }
        }
      }
    },
    "Waiting" : {
      "comment" : "A task status: the session waits on something else, a review or a build.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente"
          }
        }
      }
    },
    "Waiting for the agent to show its dialog…" : {
      "comment" : "Why a request cannot be answered yet: its dialog is not on screen yet.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente de l’affichage du dialogue de l’agent…"
          }
        }
      }
    },
    "Waiting for your approval in the web view" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attend votre accord dans la vue web"
          }
        }
      }
    },
    "Waiting in the terminal" : {
      "comment" : "The title of a request of an agent: a dialog of its terminal, of no known kind.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente dans le terminal"
          }
        }
      }
