    "Usually one to two minutes. You can close Settings: the generation goes on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عادةً دقيقة أو دقيقتان. يمكنك إغلاق الإعدادات: يستمر الإنشاء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meist ein bis zwei Minuten. Du kannst die Einstellungen schließen: Die Generierung läuft weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente uno o dos minutos. Puedes cerrar Ajustes: la generación continúa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En général une à deux minutes. Vous pouvez fermer les Réglages : la génération continue."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आमतौर पर एक से दो मिनट। आप सेटिंग्ज़ बंद कर सकते हैं: जनरेशन जारी रहता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di solito uno o due minuti. Puoi chiudere le Impostazioni: la generazione continua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常1〜2分かかります。設定を閉じても生成は続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보통 1~2분 걸립니다. 설정을 닫아도 생성은 계속됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meestal een à twee minuten. Je kunt Instellingen sluiten: het genereren gaat door."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwykle minuta lub dwie. Możesz zamknąć Ustawienia: generowanie będzie kontynuowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geralmente de um a dois minutos. Você pode fechar os Ajustes: a geração continua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычно одна-две минуты. Настройки можно закрыть: создание продолжится."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genellikle bir iki dakika sürer. Ayarlar’ı kapatabilirsiniz: oluşturma devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зазвичай хвилина-дві. Можна закрити Параметри: генерування триватиме."
