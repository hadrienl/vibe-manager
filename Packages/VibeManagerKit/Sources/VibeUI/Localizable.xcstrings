    "Only the first %lld changes are listed; the counts are exact." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُعرض إلا أول %lld تغييرات؛ الأعداد دقيقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die ersten %lld Änderungen werden aufgeführt; die Summen sind exakt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se listan los %lld primeros cambios; los totales son exactos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
