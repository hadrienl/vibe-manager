    "The session could not be put back on %@: it stays on %@, and Restart will start it with a summary." : {
      "comment" : "The agent the switch left, then the one it switched to. Restart is a command.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت إعادة الجلسة إلى %1$@: تبقى على %2$@، وستبدأها «إعادة التشغيل» بملخص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sitzung konnte nicht zu %1$@ zurückkehren: Sie bleibt bei %2$@, und „Neu starten“ startet sie mit einer Zusammenfassung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The session could not be put back on %1$@: it stays on %2$@, and Restart will start it with a summary."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión no ha podido volver a %1$@: se queda en %2$@, y “Reiniciar” la iniciará con un resumen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La session n’a pas pu revenir à %1$@ : elle reste sur %2$@, et « Relancer » la démarrera avec un résumé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेशन को %1$@ पर वापस नहीं लाया जा सका: यह %2$@ पर रहता है, और “फिर से शुरू करें” इसे सारांश के साथ शुरू करेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sessione non ha potuto tornare a %1$@: resta su %2$@ e Riavvia la avvierà con un riepilogo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションを%1$@に戻せませんでした。%2$@のままで、「再起動」すると要約付きで開始されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션을 %1$@(으)로 되돌릴 수 없었습니다. %2$@에 그대로 남으며, “재시작”하면 요약과 함께 시작됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De sessie kon niet worden teruggezet naar %1$@: ze blijft bij %2$@, en ‘Herstart’ start haar met een samenvatting."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można przywrócić sesji do %1$@: pozostaje przy %2$@, a „Uruchom ponownie” uruchomi ją z podsumowaniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível voltar a sessão para %1$@: ela continua com %2$@, e “Reiniciar” a iniciará com um resumo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось вернуть сессию на %1$@: она остаётся на %2$@, а «Перезапустить» запустит её со сводкой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum %1$@ ajanına geri döndürülemedi: %2$@ ajanında kalıyor ve “Yeniden Başlat” onu bir özetle başlatacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося повернути сеанс на %1$@: він залишається на %2$@, а «Перезапустити» запустить його з підсумком."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法让会话回到 %1$@：它将继续使用 %2$@，“重新启动”会以摘要启动它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
