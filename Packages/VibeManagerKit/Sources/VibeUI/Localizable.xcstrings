    "What the server speaks. Its documentation often says “OpenAI-compatible” or “Anthropic-compatible”." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البروتوكول الذي يستخدمه الخادم. غالبًا ما تذكر وثائقه «متوافق مع OpenAI» أو «متوافق مع Anthropic»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was der Server spricht. Seine Dokumentation sagt oft „OpenAI-kompatibel“ oder „Anthropic-kompatibel“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que habla el servidor. Su documentación suele decir “compatible con OpenAI” o “compatible con Anthropic”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que parle le serveur. Sa documentation dit souvent « compatible OpenAI » ou « compatible Anthropic »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर किस प्रोटोकॉल का उपयोग करता है। इसके दस्तावेज़ में अक्सर “OpenAI-compatible” या “Anthropic-compatible” लिखा होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il protocollo che parla il server. La sua documentazione dice spesso “compatibile con OpenAI” o “compatibile con Anthropic”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバが使用するプロトコルです。ドキュメントには「OpenAI互換」や「Anthropic互換」と書かれていることがよくあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버가 사용하는 프로토콜입니다. 서버 문서에 흔히 “OpenAI 호환” 또는 “Anthropic 호환”으로 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat de server spreekt. De documentatie zegt vaak ‘OpenAI-compatibel’ of ‘Anthropic-compatibel’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protokół serwera. Jego dokumentacja często mówi „zgodny z OpenAI” lub „zgodny z Anthropic”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que o servidor usa. A documentação dele costuma dizer “compatível com OpenAI” ou “compatível com Anthropic”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Протокол сервера. В его документации часто пишут «совместим с OpenAI» или «совместим с Anthropic»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucunun kullandığı protokol. Belgelerinde genellikle “OpenAI uyumlu” veya “Anthropic uyumlu” yazar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Протокол, яким говорить сервер. У його документації часто вказано «сумісний з OpenAI» або «сумісний з Anthropic»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器使用的协议。其文档中通常会写“兼容 OpenAI”或“兼容 Anthropic”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器使用的協定。其文件通常會寫「OpenAI 相容」或「Anthropic 相容」。"
          }
        }
      }
    },
    "What was drawn is lost." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُفقد ما تم رسمه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was gezeichnet wurde, geht verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se perderá lo dibujado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui a été dessiné sera perdu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो बनाया गया था वह खो जाएगा।"
