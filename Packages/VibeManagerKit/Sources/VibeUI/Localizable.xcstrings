    "%@ asks for new hooks to be approved once. Vibe Manager approves these ones, and no other." : {
      "comment" : "What approving does; the argument is the agent's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطلب %@ الموافقة على كل hook جديد مرة واحدة. يوافق Vibe Manager على هذه فقط، ولا شيء غيرها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verlangt, neue Hooks einmalig zu genehmigen. Vibe Manager genehmigt genau diese und keine anderen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pide aprobar una vez cada hook nuevo. Vibe Manager aprueba estos y ningún otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ demande d’approuver une fois chaque nouveau hook. Vibe Manager approuve ceux-ci, et aucun autre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ नए hooks को एक बार स्वीकृत करने के लिए कहता है। Vibe Manager इन्हें स्वीकृत करता है, किसी और को नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ chiede di approvare una volta i nuovi hook. Vibe Manager approva questi e nessun altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は新しいフックを一度承認するよう求めています。Vibe Managerはこれらのフックのみを承認し、ほかは承認しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 새로운 hook을 한 번 승인하도록 요청합니다. Vibe Manager는 이 hook만 승인하며 다른 것은 승인하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vraagt om nieuwe hooks één keer goed te keuren. Vibe Manager keurt deze goed, en geen andere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wymaga jednorazowego zatwierdzenia nowych hooków. Vibe Manager zatwierdza te i żadne inne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pede que cada novo hook seja aprovado uma vez. O Vibe Manager aprova estes, e nenhum outro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ требует однократно одобрять новые хуки. Vibe Manager одобряет только эти, и никакие другие."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, yeni hook’ların bir kez onaylanmasını istiyor. Vibe Manager yalnızca bunları onaylar, başkasını değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ просить один раз схвалити нові хуки. Vibe Manager схвалює ці, і жодних інших."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 要求对新 hook 批准一次。Vibe Manager 只批准这些 hook，不会批准其他 hook。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 要求新的 hook 需核准一次。Vibe Manager 只會核准這些，不會核准其他。"
          }
        }
      }
    },
    "%@ asks to sign in: sign in in a session's web view, then test again." : {
      "comment" : "A site.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطلب %@ تسجيل الدخول: سجّل الدخول في عرض الويب لإحدى الجلسات، ثم اختبر مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verlangt eine Anmeldung: Melde dich in der Webansicht einer Sitzung an und teste erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pide iniciar sesión: inicia sesión en la vista web de una sesión y vuelve a probar."
