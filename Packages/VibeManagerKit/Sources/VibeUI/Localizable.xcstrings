      }
    },
    "A finished session shows its last output, and can be restarted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرض الجلسة المنتهية آخر مخرجاتها، ويمكن إعادة تشغيلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine beendete Sitzung zeigt ihre letzte Ausgabe und kann neu gestartet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sesión terminada muestra su última salida y se puede reiniciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une session terminée affiche sa dernière sortie, et peut être relancée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समाप्त सेशन अपना अंतिम आउटपुट दिखाता है, और उसे फिर से शुरू किया जा सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
