        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co zostało narysowane, zostanie utracone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que foi desenhado será perdido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нарисованное будет потеряно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çizilenler kaybolur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Намальоване буде втрачено."
          }
