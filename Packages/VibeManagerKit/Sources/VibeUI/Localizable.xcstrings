    "%@ is running and will be stopped. Whatever it is doing right now will be interrupted." : {
      "comment" : "An agent's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ قيد التشغيل وسيتم إيقافه. ستتم مقاطعة كل ما يفعله الآن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ läuft und wird gestoppt. Was er gerade tut, wird unterbrochen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está en ejecución y se detendrá. Lo que esté haciendo ahora mismo se interrumpirá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est en cours d’exécution et sera arrêté. Ce qu’il est en train de faire sera interrompu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ चल रहा है और रोक दिया जाएगा। यह अभी जो कुछ कर रहा है, वह बाधित हो जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è in esecuzione e verrà arrestato. Qualunque cosa stia facendo ora verrà interrotta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は実行中で、停止されます。現在行っている処理は中断されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 실행 중이며 중단됩니다. 현재 진행 중인 작업은 중단됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is actief en wordt gestopt. Waar de agent nu mee bezig is, wordt onderbroken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ działa i zostanie zatrzymany. To, co teraz robi, zostanie przerwane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está em execução e será parado. O que ele estiver fazendo agora será interrompido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ работает и будет остановлен. Всё, что он делает сейчас, будет прервано."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ çalışıyor ve durdurulacak. Şu anda yaptığı her şey yarıda kesilecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ працює і буде зупинений. Усе, що він зараз робить, буде перервано."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在运行，将被停止。它当前正在进行的操作将被中断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在執行，將會停止。它目前進行中的工作將被中斷。"
          }
        }
      }
    },
