    "%@ was archived, but its process (pid %@) did not answer the stop and may still be running." : {
      "comment" : "A session's name, then a process identifier.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت أرشفة %1$@، لكن عمليتها (pid %2$@) لم تستجب للإيقاف وقد تكون لا تزال قيد التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wurde archiviert, aber ihr Prozess (PID %2$@) hat nicht auf das Stoppen reagiert und läuft möglicherweise noch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ was archived, but its process (pid %2$@) did not answer the stop and may still be running."
          }
