    "The symbol is drawn in white: a colour is only accepted if it can be read on it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُرسم الرمز باللون الأبيض: لا يُقبل اللون إلا إذا ظل الرمز مقروءًا عليه."
          }
        },
        "de" : {
          "stringUnit" : {
