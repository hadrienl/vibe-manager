    "The avatar could not be written to disk. It is kept until then: save it again." : {
      "comment" : "Writing a generated avatar failed; it is kept in memory.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت كتابة الصورة الرمزية على القرص. يتم الاحتفاظ بها مؤقتًا: أعد محاولة حفظها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
