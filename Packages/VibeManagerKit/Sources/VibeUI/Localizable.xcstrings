          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не запланировано. Сессия, добавленная в «К выполнению», ждёт здесь, пока вы её не запустите."
          }
        },
        "tr" : {
          "stringUnit" : {
