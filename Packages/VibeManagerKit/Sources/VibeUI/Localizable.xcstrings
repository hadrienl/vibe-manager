          }
        }
      }
    },
    "This copy of Vibe Manager was built from its source, and is never replaced by a release. Updates come to the copies downloaded from GitHub." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
