        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ साइन इन करने के लिए कहता है: किसी सेशन के वेब दृश्य में साइन इन करें, फिर दोबारा टेस्ट करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ chiede di accedere: accedi nella vista web di una sessione, poi testa di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@へのサインインが必要です。セッションのWebビューでサインインしてから、もう一度テストしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 로그인을 요청합니다. 세션의 웹 보기에서 로그인한 후 다시 테스트하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
