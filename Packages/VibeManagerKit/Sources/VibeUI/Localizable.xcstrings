    "%@ could not be opened in %@. It was revealed instead." : {
      "comment" : "A file's name, then an editor's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر فتح %1$@ في %2$@. تم عرضه في Finder بدلًا من ذلك."
