    "A development server often signs its own certificate. Continue only if it is yours." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غالبًا ما يوقّع خادم التطوير شهادته بنفسه. لا تتابع إلا إذا كان خادمك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Entwicklungsserver signiert sein Zertifikat oft selbst. Fahre nur fort, wenn es deiner ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un servidor de desarrollo suele firmar su propio certificado. Continúa solo si es tuyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un serveur de développement signe souvent son propre certificat. Ne continuez que s’il est le vôtre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डेवलपमेंट सर्वर अक्सर अपना सर्टिफ़िकेट खुद साइन करता है। केवल तभी जारी रखें जब यह आपका हो।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un server di sviluppo spesso firma il proprio certificato. Continua solo se è tuo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開発用サーバは自己署名証明書を使うことがよくあります。自分のサーバである場合のみ続けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개발 서버는 종종 자체 서명 인증서를 사용합니다. 본인의 서버인 경우에만 계속하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een ontwikkelserver ondertekent vaak zijn eigen certificaat. Ga alleen door als het jouw server is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer deweloperski często sam podpisuje swój certyfikat. Kontynuuj tylko, jeśli jest Twój."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
