        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُعثر على %@، أو لا يظهر إلا بعد تسجيل الدخول: سجّل الدخول في علامة تبويبه."
          }
        },
        "de" : {
          "stringUnit" : {
