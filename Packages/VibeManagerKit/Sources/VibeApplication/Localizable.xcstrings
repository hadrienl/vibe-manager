    "Restart it to start a new process with a summary of the session." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد تشغيلها لبدء عملية جديدة بملخص للجلسة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte sie neu, um einen neuen Prozess mit einer Zusammenfassung der Sitzung zu beginnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reiníciala para iniciar un nuevo proceso con un resumen de la sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relancez-la pour démarrer un nouveau processus avec un résumé de la session."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेशन के सारांश के साथ नई प्रोसेस शुरू करने के लिए इसे फिर से शुरू करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riavviala per avviare un nuovo processo con un riepilogo della sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再起動すると、セッションの要約を使って新しいプロセスが開始されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 요약으로 새로운 프로세스를 시작하려면 재시작하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herstart hem om een nieuw proces te starten met een samenvatting van de sessie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchom ją ponownie, aby rozpocząć nowy proces z podsumowaniem sesji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinicie-a para começar um novo processo com um resumo da sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перезапустите её, чтобы начать новый процесс со сводкой сессии."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumun özetiyle yeni bir işlem başlatmak için yeniden başlatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перезапустіть його, щоб почати новий процес із підсумком сеансу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请重新启动它，以便用会话摘要启动新进程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請重新啟動，以帶著工作階段摘要啟動新的程序。"
          }
        }
      }
    },
    "Restart the session: its conversation is resumed where the agent supports it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد تشغيل الجلسة: يتم استئناف محادثتها إذا كان الوكيل يدعم ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte die Sitzung neu: Ihre Unterhaltung wird fortgesetzt, sofern der Agent das unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinicia la sesión: su conversación se reanuda si el agente lo permite."
          }
