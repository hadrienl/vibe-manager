    "The session was left on its agent. Check that the process is gone, then try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظت الجلسة بوكيلها. تحقق من أن العملية قد توقفت، ثم حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sitzung hat ihren Agent behalten. Prüfe, ob der Prozess beendet ist, und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión ha conservado su agente. Comprueba que el proceso se haya detenido y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
