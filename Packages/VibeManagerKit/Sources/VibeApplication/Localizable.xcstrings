          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションを再起動してください。エージェントが対応していれば会話は再開されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션을 재시작하십시오. 에이전트가 지원하는 경우 대화가 재개됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
