    "%@ stopped as soon as this conversation was resumed last time, so it is not being resumed again." : {
      "comment" : "An agent's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف %@ فور استئناف هذه المحادثة في المرة الأخيرة، لذا لن يتم استئنافها مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde beim letzten Fortsetzen dieser Unterhaltung sofort beendet, daher wird sie nicht erneut fortgesetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se detuvo nada más reanudar esta conversación la última vez, así que no se vuelve a reanudar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ s’est arrêté dès la reprise de cette conversation la dernière fois : elle n’est donc pas reprise à nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछली बार यह बातचीत जारी करते ही %@ रुक गया था, इसलिए इसे फिर से जारी नहीं किया जा रहा है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ si è arrestato appena questa conversazione è stata ripresa l’ultima volta, quindi non verrà ripresa di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回この会話を再開した直後に%@が停止したため、再度の再開は行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지난번에 이 대화를 재개하자마자 %@이(가) 중단되었으므로 다시 재개하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stopte de vorige keer meteen toen dit gesprek werd hervat, dus het wordt niet opnieuw hervat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zatrzymał się zaraz po ostatnim wznowieniu tej rozmowy, więc nie zostanie ona wznowiona ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ parou assim que esta conversa foi retomada da última vez, então ela não será retomada novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В прошлый раз %@ остановился сразу после возобновления этой беседы, поэтому она не возобновляется повторно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ geçen sefer bu konuşma sürdürülür sürdürülmez durdu, bu nedenle yeniden sürdürülmüyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Минулого разу %@ зупинився одразу після продовження цієї розмови, тому її не продовжено знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次恢复此对话时 %@ 立即停止，因此不会再次恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次繼續此對話時 %@ 隨即停止，因此不會再次繼續。"
          }
        }
      }
    },
