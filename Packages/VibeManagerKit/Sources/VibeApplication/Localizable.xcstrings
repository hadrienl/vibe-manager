        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請再試一次，若問題持續請回復備份。"
          }
        }
      }
    },
    "Unarchive it first, then restart it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ألغِ أرشفتها أولًا، ثم أعد تشغيلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dearchiviere sie zuerst und starte sie dann neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
