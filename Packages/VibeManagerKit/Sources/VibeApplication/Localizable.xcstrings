    "Git refuses to read this repository: it belongs to another user." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرفض Git قراءة هذا المستودع: فهو ملك لمستخدم آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git verweigert das Lesen dieses Repositorys: Es gehört einem anderen Benutzer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git se niega a leer este repositorio: pertenece a otro usuario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git refuse de lire ce dépôt : il appartient à un autre utilisateur."
