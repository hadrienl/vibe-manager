    "Mark it as safe if you trust it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع عليه علامة آمن إذا كنت تثق به."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere es als sicher, wenn du ihm vertraust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Márcalo como seguro si confías en él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marquez-le comme sûr si vous lui faites confiance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि आप इस पर भरोसा करते हैं, तो इसे सुरक्षित चिह्नित करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrassegnalo come sicuro se ti fidi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信頼できる場合は、安全としてマークしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신뢰한다면 안전한 것으로 표시하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markeer hem als veilig als je hem vertrouwt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznacz je jako bezpieczne, jeśli mu ufasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque-o como seguro se você confia nele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отметьте его как безопасный, если доверяете ему."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güveniyorsanız güvenli olarak işaretleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позначте його як безпечний, якщо довіряєте йому."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你信任它，请将其标记为安全。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你信任它，請將其標示為安全。"
          }
        }
      }
    },
