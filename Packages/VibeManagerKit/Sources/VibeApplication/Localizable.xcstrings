    "Restarting without resuming the %@ conversation, as you asked." : {
      "comment" : "An agent's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعادة التشغيل بدون استئناف محادثة %@، كما طلبت."
