    "%@ kept no identifier for this session, so its conversation cannot be found." : {
      "comment" : "An agent's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يحتفظ %@ بأي معرّف لهذه الجلسة، لذا يتعذّر العثور على محادثتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
