    },
    "If no Git command is running any more, the lock was left behind and can be removed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا لم يعد أي أمر Git قيد التشغيل، فقد بقي القفل في مكانه ويمكن إزالته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn kein Git-Befehl mehr läuft, ist die Sperre übrig geblieben und kann entfernt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ya no hay ningún comando de Git en ejecución, el bloqueo se quedó atrás y se puede eliminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si plus aucune commande Git n’est en cours, le verrou est resté en place et peut être supprimé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि अब कोई Git कमांड नहीं चल रही, तो लॉक पीछे छूट गया है और उसे हटाया जा सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se nessun comando Git è più in esecuzione, il blocco è rimasto indietro e può essere rimosso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gitコマンドがもう実行されていなければ、ロックが残っているだけなので削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행 중인 Git 명령이 더 이상 없다면 잠금 파일이 남아 있는 것이므로 제거할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als er geen Git-opdracht meer draait, is de vergrendeling achtergebleven en kan ze worden verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli żadne polecenie Git już nie działa, blokada została porzucona i można ją usunąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se nenhum comando Git estiver mais em execução, o bloqueio ficou para trás e pode ser removido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если ни одна команда Git больше не выполняется, блокировка осталась по ошибке и её можно удалить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artık çalışan bir Git komutu yoksa kilit geride kalmıştır ve kaldırılabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо жодна команда Git уже не виконується, блокування залишилося випадково і його можна видалити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果已没有 Git 命令在运行，说明该锁是残留的，可以移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若已沒有 Git 指令在執行，表示該鎖定是殘留的，可以移除。"
          }
        }
      }
    },
