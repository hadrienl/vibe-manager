          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перезапустите сессию: её беседа будет возобновлена, если агент это поддерживает."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
