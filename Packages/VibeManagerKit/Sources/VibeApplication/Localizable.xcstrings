    "%@ does not let Vibe Manager choose a model." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يسمح %@ لـ Vibe Manager باختيار نموذج."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lässt Vibe Manager kein Modell auswählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no permite que Vibe Manager elija un modelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
