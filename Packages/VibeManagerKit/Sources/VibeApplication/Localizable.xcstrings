    "Try again, and report the failure if it persists." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حاول مرة أخرى، وأبلغ عن الإخفاق إذا استمر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versuche es erneut und melde den Fehler, wenn er weiterhin auftritt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a intentarlo e informa del fallo si persiste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réessayez, et signalez l’échec s’il persiste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फिर से कोशिश करें, और यदि समस्या बनी रहे तो इसकी रिपोर्ट करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprova e segnala l’errore se persiste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一度お試しください。問題が続く場合は報告してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 시도하고, 문제가 계속되면 실패를 보고하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer het opnieuw en meld de fout als die blijft optreden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spróbuj ponownie i zgłoś błąd, jeśli się powtarza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente novamente e relate a falha se ela persistir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторите попытку и сообщите о сбое, если он повторится."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden deneyin; sorun sürerse bildirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спробуйте ще раз і повідомте про збій, якщо він повториться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请重试；如果问题仍然存在，请报告此故障。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請再試一次，若問題持續請回報失敗。"
          }
        }
      }
    },
    "Try again, and restore a backup if it persists." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حاول مرة أخرى، واستعد نسخة احتياطية إذا استمرت المشكلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
