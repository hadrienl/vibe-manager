MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 6.0
PRODUCT_BUNDLE_IDENTIFIER = eu.hadrien.VibeManager
PRODUCT_NAME = Vibe Manager
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Vibe Manager
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.developer-tools
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ENABLE_USER_SCRIPT_SANDBOXING = YES
CLANG_ENABLE_MODULES = YES
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
CODE_SIGN_STYLE = Automatic

// English is the development language; French is translated in full (docs/localization.md). The
// compiler lists the strings it sees, so that building in Xcode keeps the catalogs up to date.
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
SWIFT_EMIT_LOC_STRINGS = YES

// Why the application asks, in each alert macOS can raise on its behalf. The agents it launches
// run as its children, so every protected folder they read is requested in its name.
INFOPLIST_KEY_NSDesktopFolderUsageDescription = Vibe Manager lets the coding agent you launched read the folder you chose.
INFOPLIST_KEY_NSDocumentsFolderUsageDescription = Vibe Manager lets the coding agent you launched read the folder you chose.
INFOPLIST_KEY_NSDownloadsFolderUsageDescription = Vibe Manager lets the coding agent you launched read the folder you chose.
INFOPLIST_KEY_NSRemovableVolumesUsageDescription = Vibe Manager opens the working folder you chose on this volume.
INFOPLIST_KEY_NSNetworkVolumesUsageDescription = Vibe Manager opens the working folder you chose on this volume.
INFOPLIST_KEY_NSFileProviderDomainUsageDescription = Vibe Manager opens the working folder you chose in iCloud Drive.

// Signing is not cosmetic: macOS keys a privacy grant to the code identity of the application, so
// an ad-hoc signature gets a new identity at every build, and every permission granted the day
// before is asked for again. The maintainer's team is the default — a Team ID is public, it is in
// every binary signed with it — and a release is signed with its Developer ID by
// Scripts/release.sh. A contributor puts their own team in Configuration/Local.xcconfig (copied from
// Local.xcconfig.example), which overrides these two lines.
DEVELOPMENT_TEAM = QMJKZ67Z3H
CODE_SIGN_IDENTITY = Apple Development
#include? "Local.xcconfig"
