// Vibe Companion (#347): the iOS debug application that proves the connection with the Mac through
// CloudKit. iOS 17.5: the first CKSyncEngine is 17.0, and iroh's bindings (#368) ask for 17.5.
#include "CompanionBase.xcconfig"

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 17.5
TARGETED_DEVICE_FAMILY = 1,2
PRODUCT_BUNDLE_IDENTIFIER = eu.hadrien.VibeManager.Companion
PRODUCT_NAME = Vibe Companion
INFOPLIST_KEY_CFBundleDisplayName = Vibe Companion
// Merged with the generated keys: the background mode of CloudKit's pushes has no setting.
INFOPLIST_FILE = App/VibeCompanion/Info.plist
// Required with the SDK 27: a launch screen and scenes, or the application does not start.
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
// iroh (#368) looks for the Mac on the local network first, which iOS asks the user about.
INFOPLIST_KEY_NSLocalNetworkUsageDescription = Vibe Companion joins your Mac directly when both are on the same network.
CODE_SIGN_ENTITLEMENTS = App/VibeCompanion/VibeCompanion.entitlements
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
// The same icon as Vibe Manager, set on white: an iOS icon has no transparency.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
